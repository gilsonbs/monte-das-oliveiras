---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Distribuição">
  <div class="topbar">
    <div>
      <p class="eyebrow">Fluxo social</p>
      <h1>Distribuição</h1>
      <p class="intro">Transforme um artigo publicado em um pacote de rascunhos para as redes sociais.</p>
    </div>
  </div>

  <section class="panel generator-panel">
    <div class="panel-head">
      <div>
        <h2>Gerar pacote</h2>
        <p>Escolha um artigo publicado. O sistema cria textos-base e links com UTM para revisão.</p>
      </div>
      <span class="status-pill">Rascunho por padrão</span>
    </div>
    <div class="generator-row">
      <label for="post-select">Artigo publicado</label>
      <select id="post-select"><option value="">Carregando artigos...</option></select>
      <button id="generate-package" class="btn-primary" type="button">Gerar pacote</button>
    </div>
    <div id="generation-status" class="status" aria-live="polite"></div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>Pacotes recentes</h2>
        <p>Revise os textos antes de publicar ou agendar em qualquer rede.</p>
      </div>
    </div>
    <div id="packages" class="packages"><p class="muted">Carregando...</p></div>
  </section>
</AdminLayout>

<script>
  import { createSupabaseBrowserClient } from '../../lib/supabase-browser';

  const supabase = createSupabaseBrowserClient();
  const siteUrl = 'https://montedasoliveiras.com';
  const postSelect = document.getElementById('post-select') as HTMLSelectElement;
  const generateButton = document.getElementById('generate-package') as HTMLButtonElement;
  const statusEl = document.getElementById('generation-status') as HTMLElement;
  const packagesEl = document.getElementById('packages') as HTMLElement;
  const packageRows = new Map<string, any>();
  const packageDialog = document.getElementById('package-dialog') as HTMLDialogElement;
  document.getElementById('close-package-dialog')?.addEventListener('click', () => packageDialog.close());

  function setStatus(message: string, type = '') {
    statusEl.textContent = message;
    statusEl.className = `status ${type}`;
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char] || char));
  }

  async function generatePackage(post: any) {
    const articleUrl = `${siteUrl}/${post.slug}/`;
    const { data, error } = await supabase.functions.invoke('generate-social-package', {
      body: { title: post.title, excerpt: post.excerpt, slug: post.slug, articleUrl },
    });
    if (error) throw error;
    return data.package;
  }

  function renderPackages(rows: any[]) {
    if (!rows.length) {
      packagesEl.innerHTML = '<p class="muted">Nenhum pacote criado ainda.</p>';
      return;
    }
    rows.forEach((row) => packageRows.set(row.id, row));
    packagesEl.innerHTML = rows.map((row) => {
      const article = row.package?.article || {};
      return `<article class="package-card">
        <div><span class="package-status">${escapeHtml(row.status)}</span><h3>${escapeHtml(article.title || 'Artigo')}</h3>
        <p>${escapeHtml(article.excerpt || '')}</p></div>
        <div class="package-meta"><span>${new Date(row.updated_at).toLocaleDateString('pt-BR')}</span><button class="open-package" type="button" data-package-id="${row.id}">Abrir pacote</button><a href="/admin/posts/editor?id=${row.post_id}">Editar artigo</a></div>
      </article>`;
    }).join('');
    packagesEl.querySelectorAll<HTMLButtonElement>('.open-package').forEach((button) => {
      button.addEventListener('click', () => openPackage(button.dataset.packageId || ''));
    });
  }

  function openPackage(id: string) {
    const row = packageRows.get(id);
    if (!row) return;
    const pack = row.package || {};
    const blocks = [
      ['Vídeo', `${pack.video?.hook || ''}\n\n${pack.video?.script || ''}\n\nCTA: ${pack.video?.cta || ''}`],
      ['Instagram', `${pack.instagram?.caption || ''}\n\n${pack.instagram?.url || ''}`],
      ['Facebook', `${pack.facebook?.text || ''}`],
      ['YouTube', `${pack.youtube?.title || ''}\n\n${pack.youtube?.description || ''}`],
      ['TikTok', `${pack.tiktok?.caption || ''}\n\n${pack.tiktok?.url || ''}`],
      ['Pinterest', `${pack.pinterest?.title || ''}\n\n${pack.pinterest?.description || ''}\n\n${pack.pinterest?.url || ''}`],
    ];
    const content = blocks.map(([label, text]) => `<section class="content-block"><div class="content-block-head"><h3>${label}</h3><button type="button" class="copy-content" data-copy="${encodeURIComponent(text)}">Copiar</button></div><pre>${escapeHtml(text)}</pre></section>`).join('');
    const dialog = packageDialog;
    dialog.querySelector('.dialog-title')!.textContent = pack.article?.title || 'Pacote de distribuição';
    dialog.querySelector('.dialog-content')!.innerHTML = content;
    dialog.showModal();
    dialog.querySelectorAll<HTMLButtonElement>('.copy-content').forEach((button) => {
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(decodeURIComponent(button.dataset.copy || ''));
        button.textContent = 'Copiado';
        setTimeout(() => { button.textContent = 'Copiar'; }, 1200);
      });
    });
  }

  async function loadPosts() {
    const { data, error } = await supabase.from('posts').select('id, title, slug, excerpt').eq('status', 'published').order('published_at', { ascending: false }).limit(100);
    if (error) { postSelect.innerHTML = '<option value="">Não foi possível carregar os artigos</option>'; return; }
    postSelect.innerHTML = '<option value="">Selecione um artigo</option>' + (data || []).map((post) => `<option value="${post.id}">${escapeHtml(post.title)}</option>`).join('');
    (window as any).__posts = data || [];
  }

  async function loadPackages() {
    const { data, error } = await supabase.from('content_distribution_packages').select('id, post_id, status, package, updated_at').order('updated_at', { ascending: false }).limit(20);
    if (error) { packagesEl.innerHTML = '<p class="muted">Aplique o schema-content-distribution.sql no Supabase para ativar este fluxo.</p>'; return; }
    renderPackages(data || []);
  }

  generateButton.addEventListener('click', async () => {
    const post = ((window as any).__posts || []).find((item: any) => item.id === postSelect.value);
    if (!post) { setStatus('Selecione um artigo publicado.', 'error'); return; }
    generateButton.disabled = true;
    setStatus('Gerando pacote com Gemini...');
    let generatedPackage;
    try {
      generatedPackage = await generatePackage(post);
    } catch (error: any) {
      generateButton.disabled = false;
      setStatus(`Erro ao gerar com Gemini: ${error.message || 'verifique a chave e o deploy da função.'}`, 'error');
      return;
    }
    const payload = { post_id: post.id, status: 'draft', package: generatedPackage, updated_at: new Date().toISOString() };
    const { error } = await supabase.from('content_distribution_packages').upsert(payload, { onConflict: 'post_id' });
    generateButton.disabled = false;
    if (error) { setStatus(`Erro: ${error.message}`, 'error'); return; }
    setStatus('Pacote criado como rascunho. A próxima etapa é revisar o conteúdo.', 'ok');
    await loadPackages();
  });

  await Promise.all([loadPosts(), loadPackages()]);
</script>

<dialog id="package-dialog" class="package-dialog">
  <div class="dialog-head"><h2 class="dialog-title">Pacote de distribuição</h2><button id="close-package-dialog" type="button" class="close-dialog">Fechar</button></div>
  <div class="dialog-content"></div>
</dialog>

<style>
  .topbar { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 26px; }
  h1 { margin: 0 0 8px; font-family: var(--font-display); color: var(--olive-deep); font-size: 32px; }
  h2 { margin: 0 0 6px; color: var(--olive-deep); font-size: 18px; }
  h3 { margin: 8px 0 5px; color: var(--olive-deep); font-size: 15px; }
  .eyebrow { margin: 0 0 5px; color: var(--ember); font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .intro, .panel-head p { margin: 0; color: #77705F; font-size: 13px; }
  .panel { margin-bottom: 18px; padding: 20px 22px; border: 1px solid #E9E4D7; border-radius: 8px; background: #fff; }
  .panel-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 18px; }
  .status-pill, .package-status { display: inline-flex; padding: 5px 9px; border-radius: 999px; background: #F2EEE3; color: #756A4D; font-size: 11px; font-weight: 700; }
  .generator-row { display: grid; grid-template-columns: 145px 1fr auto; align-items: center; gap: 10px; }
  label { color: #5F5E5A; font-size: 12px; font-weight: 700; }
  select { min-height: 40px; border: 1px solid #DCD6C8; border-radius: 6px; padding: 0 10px; background: #fff; color: var(--ink); font: inherit; }
  .btn-primary { min-height: 40px; border: 0; border-radius: 6px; padding: 0 15px; background: var(--olive-deep); color: #fff; font: 600 13px var(--font-ui); cursor: pointer; }
  .btn-primary:disabled { opacity: .55; cursor: wait; }
  .status { min-height: 18px; margin-top: 10px; color: #77705F; font-size: 12px; }
  .status.ok { color: #3B7441; } .status.error { color: #A6462A; }
  .packages { display: grid; gap: 10px; }
  .package-card { display: flex; justify-content: space-between; gap: 20px; padding: 15px; border: 1px solid #EEEAE0; border-radius: 7px; background: #FAF8F1; }
  .package-card p { margin: 0; color: #77705F; font-size: 12px; line-height: 1.5; }
  .package-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; color: #8A8367; font-size: 11px; white-space: nowrap; }
  .package-meta a { color: var(--olive-deep); font-weight: 700; text-decoration: none; }
  .package-meta button, .copy-content, .close-dialog { border: 0; border-radius: 5px; padding: 7px 10px; background: var(--olive-deep); color: #fff; font: 600 11px var(--font-ui); cursor: pointer; }
  .package-meta button { background: #EEE8D7; color: var(--olive-deep); }
  .package-dialog { width: min(760px, calc(100vw - 32px)); max-height: 88vh; padding: 0; border: 1px solid #DCD6C8; border-radius: 8px; color: var(--ink); }
  .package-dialog::backdrop { background: rgba(21, 46, 58, .48); }
  .dialog-head { position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 20px; background: #fff; border-bottom: 1px solid #EEEAE0; }
  .dialog-head h2 { margin: 0; font-size: 18px; }
  .dialog-content { display: grid; gap: 14px; padding: 18px 20px 24px; }
  .content-block { border: 1px solid #E9E4D7; border-radius: 6px; background: #FAF8F1; }
  .content-block-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid #E9E4D7; }
  .content-block-head h3 { margin: 0; font-size: 14px; }
  .content-block pre { overflow-x: auto; margin: 0; padding: 12px; white-space: pre-wrap; font: 12px/1.55 var(--font-ui); }
  .muted { color: #8A8367; font-size: 13px; }
  @media (max-width: 700px) { .generator-row { grid-template-columns: 1fr; } .package-card { display: grid; } .package-meta { align-items: flex-start; } }
</style>
