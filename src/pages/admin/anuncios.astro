---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Anúncios">
  <div class="topbar">
    <div>
      <h1>Monetização</h1>
      <p class="subtitle">Controle anúncios e prepare os próximos blocos de receita do site.</p>
    </div>
  </div>

  <div class="notice">
    <strong>Como funciona hoje:</strong>
    os anúncios são configurados aqui, salvos no banco e aparecem no site depois de publicar as mudanças.
    Enquanto um slot não estiver completo e ativo, o site mostra apenas um espaço reservado.
  </div>

  <div class="summary-grid" id="summary-grid">
    <div class="summary-card">
      <span>Slots ativos</span>
      <strong id="active-count">—</strong>
    </div>
    <div class="summary-card">
      <span>Prontos para AdSense</span>
      <strong id="ready-count">—</strong>
    </div>
    <div class="summary-card">
      <span>Próxima frente</span>
      <strong>Leads</strong>
    </div>
  </div>

  <div class="panel" id="slots-panel">
    <p class="muted">Carregando...</p>
  </div>

  <div class="panel affiliate-panel">
    <div class="panel-heading">
      <div>
        <h2>CTAs de afiliados</h2>
        <p>Cadastre recomendações por página, categoria ou padrão geral. Elas só aparecem quando houver link válido.</p>
      </div>
      <div class="affiliate-actions">
        <button type="button" class="btn-secondary" id="add-affiliate-cta">Adicionar CTA</button>
        <button type="button" id="save-affiliate-ctas">Salvar CTAs</button>
      </div>
    </div>
    <div id="affiliate-list" class="affiliate-list"></div>
    <textarea id="affiliate-ctas" hidden></textarea>
    <div class="affiliate-help">
      Página específica tem prioridade sobre categoria. O padrão geral aparece só quando não houver CTA mais específico.
    </div>
    <div class="affiliate-status" id="affiliate-status"></div>
  </div>

  <div class="panel lead-panel">
    <div class="panel-heading">
      <div>
        <h2>Captura de leads</h2>
        <p>Configure uma oferta gratuita para capturar e-mails nos artigos.</p>
      </div>
      <button type="button" id="save-lead-magnet">Salvar oferta</button>
    </div>
    <div class="lead-grid">
      <label class="switch-line">
        <input type="checkbox" id="lead-active" />
        <span>Ativar bloco nos artigos</span>
      </label>
      <label>
        Título da oferta
        <input type="text" id="lead-title" placeholder="Plano de leitura bíblica de 30 dias" />
      </label>
      <label>
        Texto do botão
        <input type="text" id="lead-button" placeholder="Receber material gratuito" />
      </label>
      <label class="full">
        Descrição
        <textarea id="lead-description" rows="3" placeholder="Receba um roteiro simples para criar constância na leitura bíblica e fortalecer sua vida devocional."></textarea>
      </label>
      <label class="full">
        Nota de privacidade
        <input type="text" id="lead-privacy" placeholder="Você receberá conteúdos do Monte das Oliveiras. Pode sair da lista quando quiser." />
      </label>
    </div>
    <div class="affiliate-help">
      Depois de salvar e publicar, o bloco aparece nos artigos. Os inscritos serão salvos na tabela <strong>newsletter_subscribers</strong>.
    </div>
    <div class="affiliate-status" id="lead-status"></div>
  </div>

  <div class="plan-grid">
    <div class="plan-card">
      <div class="plan-step">Fase 1</div>
      <h2>AdSense limpo</h2>
      <p>Ativar poucos slots, medir impacto e não poluir as páginas de estudo.</p>
    </div>
    <div class="plan-card">
      <div class="plan-step">Fase 2</div>
      <h2>Afiliados por intenção</h2>
      <p>Adicionar recomendações em artigos de livros, Bíblias, cursos e materiais cristãos.</p>
    </div>
    <div class="plan-card">
      <div class="plan-step">Fase 3</div>
      <h2>Lista e produtos</h2>
      <p>Capturar leads com materiais gratuitos antes de criar PDFs, devocionais e produtos pagos.</p>
    </div>
  </div>
</AdminLayout>

<script>
  import { createSupabaseBrowserClient } from '../../lib/supabase-browser';
  const supabase = createSupabaseBrowserClient();

  const SLOT_LABELS: Record<string, { label: string; location: string; size: string }> = {
    sidebar_300x600: {
      label: 'Sidebar',
      location: 'Lateral de artigos, categorias e home',
      size: '300×600',
    },
    in_article: {
      label: 'Dentro do artigo',
      location: 'Entre a resposta inicial e o restante do conteúdo',
      size: '300×250 responsivo',
    },
    feed_native: {
      label: 'Feed nativo',
      location: 'Entre cards da home',
      size: '300×175',
    },
  };

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function isValidClient(value: string) {
    return /^ca-pub-\d{10,}$/.test(value);
  }

  function isValidSlotId(value: string) {
    return /^\d{6,}$/.test(value);
  }

  function getSlotState(slot: any) {
    if (!slot.active) return { className: 'off', label: 'Inativo' };
    if (isValidClient(slot.ad_client || '') && isValidSlotId(slot.ad_slot_id || '')) return { className: 'ready', label: 'Pronto' };
    return { className: 'warn', label: 'Incompleto' };
  }

  function getEmptyAffiliateCta() {
    return {
      type: 'slug',
      target: '',
      title: '',
      description: '',
      buttonLabel: 'Ver recomendação',
      url: '',
    };
  }

  function normalizeAffiliateCtas(value: string) {
    if (!value.trim()) return [];

    try {
      const parsed = JSON.parse(value);
      const items = Array.isArray(parsed) ? parsed : [parsed];

      return items.map((item: any) => {
        const type = item.default ? 'default' : item.category ? 'category' : 'slug';
        return {
          type,
          target: type === 'category' ? item.category || '' : type === 'slug' ? item.slug || '' : '',
          title: item.title || '',
          description: item.description || '',
          buttonLabel: item.buttonLabel || 'Ver recomendação',
          url: item.url || '',
        };
      });
    } catch {
      return [];
    }
  }

  function serializeAffiliateCtas() {
    return Array.from(document.querySelectorAll('.affiliate-card')).map((card) => {
      const type = (card.querySelector('.affiliate-type') as HTMLSelectElement).value;
      const target = (card.querySelector('.affiliate-target') as HTMLInputElement).value.trim();
      const title = (card.querySelector('.affiliate-title') as HTMLInputElement).value.trim();
      const description = (card.querySelector('.affiliate-description') as HTMLTextAreaElement).value.trim();
      const buttonLabel = (card.querySelector('.affiliate-button-label') as HTMLInputElement).value.trim();
      const url = (card.querySelector('.affiliate-url') as HTMLInputElement).value.trim();
      const item: any = { title, description, buttonLabel, url };

      if (type === 'default') item.default = true;
      if (type === 'category') item.category = target;
      if (type === 'slug') item.slug = target;

      return item;
    });
  }

  function syncAffiliateTextarea() {
    const textarea = document.getElementById('affiliate-ctas') as HTMLTextAreaElement;
    textarea.value = JSON.stringify(serializeAffiliateCtas(), null, 2);
  }

  function getTargetPlaceholder(type: string) {
    if (type === 'category') return 'estudos-biblicos';
    if (type === 'slug') return 'livros-impactantes-da-biblia';
    return 'Usado como padrão geral';
  }

  function renderAffiliateEditor(items: any[]) {
    const list = document.getElementById('affiliate-list')!;
    const normalized = items.length ? items : [getEmptyAffiliateCta()];

    list.innerHTML = normalized
      .map((item, index) => {
        const type = item.type || 'slug';
        const targetDisabled = type === 'default' ? 'disabled' : '';
        return `
          <div class="affiliate-card">
            <div class="affiliate-card-head">
              <strong>CTA ${index + 1}</strong>
              <button type="button" class="remove-affiliate-cta" ${normalized.length === 1 ? 'disabled' : ''}>Remover</button>
            </div>
            <div class="affiliate-grid">
              <label>
                Tipo
                <select class="affiliate-type">
                  <option value="slug" ${type === 'slug' ? 'selected' : ''}>Página específica</option>
                  <option value="category" ${type === 'category' ? 'selected' : ''}>Categoria</option>
                  <option value="default" ${type === 'default' ? 'selected' : ''}>Padrão geral</option>
                </select>
              </label>
              <label>
                Slug ou categoria
                <input class="affiliate-target" type="text" value="${escapeHtml(item.target || '')}" placeholder="${getTargetPlaceholder(type)}" ${targetDisabled} />
              </label>
              <label>
                Título
                <input class="affiliate-title" type="text" value="${escapeHtml(item.title || '')}" placeholder="Materiais para aprofundar seu estudo bíblico" />
              </label>
              <label>
                Texto do botão
                <input class="affiliate-button-label" type="text" value="${escapeHtml(item.buttonLabel || 'Ver recomendação')}" placeholder="Ver recomendação" />
              </label>
              <label class="full">
                Link de afiliado
                <input class="affiliate-url" type="url" value="${escapeHtml(item.url || '')}" placeholder="https://..." />
              </label>
              <label class="full">
                Descrição
                <textarea class="affiliate-description" rows="2" placeholder="Explique por que esse material combina com o artigo.">${escapeHtml(item.description || '')}</textarea>
              </label>
            </div>
          </div>
        `;
      })
      .join('');

    list.querySelectorAll('input, textarea, select').forEach((field) => {
      field.addEventListener('input', syncAffiliateTextarea);
      field.addEventListener('change', () => {
        const card = (field as HTMLElement).closest('.affiliate-card')!;
        const type = (card.querySelector('.affiliate-type') as HTMLSelectElement).value;
        const target = card.querySelector('.affiliate-target') as HTMLInputElement;
        target.disabled = type === 'default';
        target.placeholder = getTargetPlaceholder(type);
        if (type === 'default') target.value = '';
        syncAffiliateTextarea();
      });
    });

    list.querySelectorAll('.remove-affiliate-cta').forEach((button) => {
      button.addEventListener('click', () => {
        (button as HTMLElement).closest('.affiliate-card')?.remove();
        if (!list.querySelector('.affiliate-card')) renderAffiliateEditor([getEmptyAffiliateCta()]);
        syncAffiliateTextarea();
      });
    });

    syncAffiliateTextarea();
  }

  function validateAffiliateCtas(value: string) {
    if (!value.trim()) return { ok: true, parsed: [] };

    try {
      const parsed = JSON.parse(value);
      const items = Array.isArray(parsed) ? parsed : [parsed];
      const invalidIndex = items.findIndex((item: any) => {
        const hasTarget = item.default === true || Boolean(item.slug || item.category);
        return !item?.title || !item?.buttonLabel || !item?.url || !hasTarget;
      });

      if (invalidIndex >= 0) {
        return { ok: false, message: `O CTA ${invalidIndex + 1} precisa de destino, título, texto do botão e link.` };
      }

      return { ok: true, parsed: items };
    } catch {
      return { ok: false, message: 'O JSON está inválido. Confira vírgulas, aspas e colchetes.' };
    }
  }

  function parseLeadConfig(value: string) {
    try {
      return value ? JSON.parse(value) : {};
    } catch {
      return {};
    }
  }

  async function load() {
    const { data: existing } = await supabase.from('ad_slots').select('*');
    const existingByKey = new Map((existing ?? []).map((s: any) => [s.key, s]));

    const slots = Object.entries(SLOT_LABELS).map(([key, info]) => ({
      key,
      ...info,
      ...(existingByKey.get(key) || { ad_client: '', ad_slot_id: '', format: 'auto', active: false }),
    }));

    const activeCount = slots.filter((slot: any) => slot.active).length;
    const readyCount = slots.filter((slot: any) => slot.active && isValidClient(slot.ad_client || '') && isValidSlotId(slot.ad_slot_id || '')).length;
    document.getElementById('active-count')!.textContent = String(activeCount);
    document.getElementById('ready-count')!.textContent = `${readyCount}/${slots.length}`;

    const panel = document.getElementById('slots-panel')!;
    panel.innerHTML = slots
      .map(
        (slot: any) => {
          const state = getSlotState(slot);
          return `
        <div class="slot-row" data-key="${slot.key}">
          <div class="slot-main">
            <div class="slot-title">
              <strong>${escapeHtml(slot.label)}</strong>
              <span class="slot-status ${state.className}">${state.label}</span>
            </div>
            <div class="slot-location">${escapeHtml(slot.location)} · ${escapeHtml(slot.size)}</div>
          </div>
          <div class="slot-fields">
            <input type="text" class="ad-client" placeholder="ca-pub-XXXXXXXXXX" value="${escapeHtml(slot.ad_client || '')}" />
            <input type="text" class="ad-slot-id" placeholder="ID do bloco" value="${escapeHtml(slot.ad_slot_id || '')}" />
          </div>
          <div class="slot-actions">
            <label class="switch-wrap">
              <input type="checkbox" class="ad-active" ${slot.active ? 'checked' : ''} />
              <span class="switch"></span>
            </label>
            <button class="btn-save-slot">Salvar</button>
          </div>
          <div class="slot-help"></div>
        </div>
      `;
        }
      )
      .join('');

    document.querySelectorAll('.btn-save-slot').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const row = (e.target as HTMLElement).closest('.slot-row') as HTMLElement;
        const key = row.dataset.key!;
        const ad_client = (row.querySelector('.ad-client') as HTMLInputElement).value.trim();
        const ad_slot_id = (row.querySelector('.ad-slot-id') as HTMLInputElement).value.trim();
        const active = (row.querySelector('.ad-active') as HTMLInputElement).checked;
        const help = row.querySelector('.slot-help') as HTMLElement;

        if (active && (!isValidClient(ad_client) || !isValidSlotId(ad_slot_id))) {
          help.textContent = 'Para ativar, preencha um Publisher ID válido e um ID de bloco numérico.';
          help.className = 'slot-help error';
          return;
        }

        const { error } = await supabase
          .from('ad_slots')
          .upsert({ key, label: key, ad_client, ad_slot_id, format: 'auto', active }, { onConflict: 'key' });

        if (error) alert(`Erro: ${error.message}`);
        else {
          (e.target as HTMLElement).textContent = 'Salvo!';
          help.textContent = 'Configuração salva. Publique as mudanças para atualizar o site.';
          help.className = 'slot-help ok';
          (window as any).markAdminChangesPending?.('Anúncio salvo. Publique as mudanças para atualizar o site.');
          setTimeout(() => {
            (e.target as HTMLElement).textContent = 'Salvar';
            load();
          }, 1500);
        }
      });
    });

    const { data: affiliateSetting } = await supabase
      .from('public_site_settings')
      .select('value')
      .eq('key', 'affiliate_ctas')
      .maybeSingle();

    const affiliateTextarea = document.getElementById('affiliate-ctas') as HTMLTextAreaElement;
    affiliateTextarea.value = affiliateSetting?.value || '';
    renderAffiliateEditor(normalizeAffiliateCtas(affiliateTextarea.value));

    const { data: leadSetting } = await supabase
      .from('public_site_settings')
      .select('value')
      .eq('key', 'lead_magnet_config')
      .maybeSingle();

    const leadConfig = parseLeadConfig(leadSetting?.value || '');
    (document.getElementById('lead-active') as HTMLInputElement).checked = Boolean(leadConfig.active);
    (document.getElementById('lead-title') as HTMLInputElement).value = leadConfig.title || '';
    (document.getElementById('lead-button') as HTMLInputElement).value = leadConfig.buttonLabel || '';
    (document.getElementById('lead-description') as HTMLTextAreaElement).value = leadConfig.description || '';
    (document.getElementById('lead-privacy') as HTMLInputElement).value = leadConfig.privacyNote || '';
  }

  load();

  document.getElementById('add-affiliate-cta')?.addEventListener('click', () => {
    const current = serializeAffiliateCtas().map((item: any) => ({
      type: item.default ? 'default' : item.category ? 'category' : 'slug',
      target: item.category || item.slug || '',
      title: item.title || '',
      description: item.description || '',
      buttonLabel: item.buttonLabel || 'Ver recomendação',
      url: item.url || '',
    }));
    renderAffiliateEditor([...current, getEmptyAffiliateCta()]);
  });

  document.getElementById('save-affiliate-ctas')?.addEventListener('click', async (e) => {
    const button = e.target as HTMLButtonElement;
    const textarea = document.getElementById('affiliate-ctas') as HTMLTextAreaElement;
    const status = document.getElementById('affiliate-status') as HTMLElement;
    const rawValue = textarea.value.trim();
    const validation = validateAffiliateCtas(rawValue);

    if (!validation.ok) {
      status.textContent = validation.message || 'Revise os CTAs antes de salvar.';
      status.className = 'affiliate-status error';
      return;
    }

    button.disabled = true;
    button.textContent = 'Salvando...';

    const { error } = await supabase
      .from('public_site_settings')
      .upsert({ key: 'affiliate_ctas', value: rawValue }, { onConflict: 'key' });

    if (error) {
      status.textContent = `Erro: ${error.message}`;
      status.className = 'affiliate-status error';
      button.disabled = false;
      button.textContent = 'Salvar CTAs';
      return;
    }

    status.textContent = 'CTAs salvos. Publique as mudanças para atualizar o site.';
    status.className = 'affiliate-status ok';
    (window as any).markAdminChangesPending?.('CTAs de afiliados salvos. Publique as mudanças para atualizar o site.');
    button.disabled = false;
    button.textContent = 'Salvar CTAs';
  });

  document.getElementById('save-lead-magnet')?.addEventListener('click', async (e) => {
    const button = e.target as HTMLButtonElement;
    const status = document.getElementById('lead-status') as HTMLElement;
    const active = (document.getElementById('lead-active') as HTMLInputElement).checked;
    const title = (document.getElementById('lead-title') as HTMLInputElement).value.trim();
    const buttonLabel = (document.getElementById('lead-button') as HTMLInputElement).value.trim();
    const description = (document.getElementById('lead-description') as HTMLTextAreaElement).value.trim();
    const privacyNote = (document.getElementById('lead-privacy') as HTMLInputElement).value.trim();

    if (active && (!title || !buttonLabel)) {
      status.textContent = 'Para ativar, preencha pelo menos o título e o texto do botão.';
      status.className = 'affiliate-status error';
      return;
    }

    button.disabled = true;
    button.textContent = 'Salvando...';

    const value = JSON.stringify({
      active,
      title,
      description,
      buttonLabel,
      privacyNote,
      source: 'article_lead_magnet',
    });

    const { error } = await supabase
      .from('public_site_settings')
      .upsert({ key: 'lead_magnet_config', value }, { onConflict: 'key' });

    if (error) {
      status.textContent = `Erro: ${error.message}`;
      status.className = 'affiliate-status error';
      button.disabled = false;
      button.textContent = 'Salvar oferta';
      return;
    }

    status.textContent = 'Oferta salva. Publique as mudanças para atualizar o site.';
    status.className = 'affiliate-status ok';
    (window as any).markAdminChangesPending?.('Oferta de captura salva. Publique as mudanças para atualizar o site.');
    button.disabled = false;
    button.textContent = 'Salvar oferta';
  });
</script>

<style>
  .topbar { margin-bottom: 12px; }
  .topbar h1 { font-family: var(--font-display); font-size: 22px; font-weight: 600; margin: 0; }
  .subtitle { font-size: 13px; color: #8A8367; margin: 4px 0 0; }
  .notice { background: #fff; border: 1px solid #E4E0D3; border-radius: 8px; padding: 14px 16px; max-width: 820px; margin: 0 0 18px; color: #5F5E5A; font-size: 13px; line-height: 1.6; }
  .summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; max-width: 820px; margin-bottom: 18px; }
  .summary-card { background: #fff; border: 1px solid #E4E0D3; border-radius: 8px; padding: 16px; }
  .summary-card span { display: block; color: #8A8367; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; }
  .summary-card strong { color: var(--olive-deep); font-family: var(--font-display); font-size: 22px; font-weight: 600; }
  .panel { background: #fff; border: 1px solid #E4E0D3; border-radius: 8px; padding: 8px 22px; max-width: 920px; }
  .muted { color: #8A8367; font-size: 13px; padding: 14px 0; }
  .panel :global(.slot-row) { display: grid; grid-template-columns: 240px 1fr 140px; gap: 14px; align-items: center; padding: 16px 0; border-bottom: 1px solid #F1EFE8; }
  .panel :global(.slot-row:last-child) { border-bottom: none; }
  .panel :global(.slot-main) { min-width: 0; }
  .panel :global(.slot-title) { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
  .panel :global(.slot-title strong) { font-size: 13px; font-weight: 600; color: var(--ink); }
  .panel :global(.slot-location) { font-size: 11.5px; color: #8A8367; line-height: 1.35; }
  .panel :global(.slot-status) { border-radius: 999px; padding: 2px 7px; font-size: 10px; font-weight: 700; }
  .panel :global(.slot-status.ready) { background: #EEF1E4; color: var(--olive-deep); }
  .panel :global(.slot-status.warn) { background: #FFF4D8; color: #7A6418; }
  .panel :global(.slot-status.off) { background: #F1EFE8; color: #8A8367; }
  .panel :global(.slot-fields) { display: grid; grid-template-columns: 1fr 150px; gap: 8px; }
  .panel :global(.slot-actions) { display: flex; align-items: center; justify-content: flex-end; gap: 12px; }
  .panel :global(.slot-row input[type=text]) { padding: 7px 10px; border: 1px solid #E4E0D3; border-radius: 6px; font-family: var(--font-ui); font-size: 12px; }
  .panel :global(.btn-save-slot) { font-family: var(--font-ui); font-size: 12px; padding: 7px 12px; border-radius: 6px; border: 1px solid #E4E0D3; background: #fff; cursor: pointer; }
  .panel :global(.slot-help) { grid-column: 2 / 4; color: #8A8367; font-size: 11.5px; margin-top: -8px; min-height: 16px; }
  .panel :global(.slot-help.ok) { color: var(--olive-deep); }
  .panel :global(.slot-help.error) { color: #A6462A; }
  .affiliate-panel { margin-top: 18px; padding: 18px 22px; }
  .panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .panel-heading h2 { margin: 0 0 4px; font-family: var(--font-display); color: var(--olive-deep); font-size: 19px; font-weight: 600; }
  .panel-heading p { margin: 0; color: #8A8367; font-size: 12.5px; line-height: 1.45; }
  .affiliate-actions { display: flex; gap: 8px; }
  .affiliate-actions button { font-family: var(--font-ui); font-size: 12px; font-weight: 700; padding: 8px 13px; border-radius: 6px; border: 1px solid var(--olive-deep); color: #fff; background: var(--olive-deep); cursor: pointer; white-space: nowrap; }
  .affiliate-actions .btn-secondary { background: #fff; color: var(--olive-deep); }
  .panel-heading button:disabled { opacity: .7; cursor: wait; }
  .affiliate-list { display: grid; gap: 12px; }
  .affiliate-list:empty::before { content: "Nenhum CTA cadastrado."; display: block; color: #8A8367; font-size: 13px; padding: 12px 0; }
