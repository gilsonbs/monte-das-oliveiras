    title: 'Pornografia é Pecado? Como Proteger a Mente e a Fé',
    description:
      'Entenda por que a pornografia fere a vida cristã e veja caminhos práticos para proteger a mente, buscar pureza e restauração.',
  },
  'arrebatamento-o-que-acontece': {
    title: 'O Que Acontece no Arrebatamento? Visões Bíblicas',
    description:
      'Entenda as principais visões cristãs sobre o arrebatamento, sua relação com a volta de Cristo e a esperança da igreja.',
  },
  'profecia-do-ultimo-papa': {
    title: 'Profecia do Último Papa: História, Mito e Discernimento',
    description:
      'Conheça a chamada profecia do último papa, sua origem histórica, debates e limites para uma leitura cristã cuidadosa.',
  },
  'fenomenos-sobrenaturais': {
    title: 'Fenômenos Sobrenaturais: Profecia, Coincidência ou Sinais?',
    description:
      'Entenda como avaliar relatos de fenômenos sobrenaturais com discernimento bíblico, prudência e atenção aos sinais dos tempos.',
  },
  'crente-pode-ser-cremado': {
    title: 'Crente Pode Ser Cremado? O Debate Bíblico e Teológico',
    description:
      'Entenda se o crente pode ser cremado, quais princípios bíblicos entram no debate e como decidir com consciência cristã.',
  },
  'ia-tecnologia': {
    title: 'Inteligência Artificial, Tecnologia e Profecia Bíblica',
    description:
      'Reflita sobre inteligência artificial, tecnologia, controle global e profecia bíblica com discernimento e equilíbrio cristão.',
  },
  'amar-ao-proximo': {
    title: 'Amar ao Próximo: O Maior Ensinamento de Amor de Jesus',
    description:
      'Entenda por que amar ao próximo está no centro do evangelho e como esse mandamento transforma fé, serviço e relacionamentos.',
  },
  '7-sinais-do-fim': {
    title: '7 Sinais do Fim dos Tempos: Como Entender pela Bíblia',
    description:
      'Veja sete sinais associados ao fim dos tempos e entenda como analisá-los com vigilância, esperança e fidelidade bíblica.',
  },
  'mateus-24': {
    title: 'Mateus 24: Vigiai e Estejam Prontos para a Volta de Cristo',
    description:
      'Entenda a mensagem central de Mateus 24, o chamado de Jesus à vigilância e a esperança cristã diante dos sinais.',
  },
  'paz-interior': {
    title: 'Paz Interior na Vida Cristã: Práticas Bíblicas Simples',
    description:
      'Veja práticas bíblicas para cultivar paz interior, lidar com ansiedade e fortalecer a confiança em Deus no dia a dia.',
  },
  'profetas-fake-news': {
    title: 'Falsos Profetas Digitais: Discernimento Bíblico na Internet',
    description:
      'Entenda como identificar falsos profetas digitais, proteger a fé e avaliar mensagens religiosas com base nas Escrituras.',
  },
};

const seo = seoOverrides[post.slug] ?? {};
const pageTitle = seo.title || post.seo_title || post.title;
const pageDescription = seo.description || post.meta_description || post.excerpt || undefined;
const priorityAnswer = priorityArticleAnswers[post.slug];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: pageTitle,
    description: pageDescription,
    image: absImage ? [absImage] : undefined,
    datePublished: publishedISO,
    dateModified: publishedISO,
    author: { '@type': 'Organization', name: 'Monte das Oliveiras', url: siteURL },
    publisher: {
      '@type': 'Organization',
      name: 'Monte das Oliveiras',
      logo: { '@type': 'ImageObject', url: `${siteURL}/apple-touch-icon.png` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': postURL },
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
      ...(post.category_name && post.category_slug ? [{ '@type': 'ListItem', position: 2, name: post.category_name, item: `${siteURL}/categoria/${post.category_slug}/` }] : []),
      { '@type': 'ListItem', position: post.category_name ? 3 : 2, name: post.title, item: postURL },
    ],
  },
  ...(priorityAnswer ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [{
      '@type': 'Question',
      name: priorityAnswer.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: priorityAnswer.answer,
      },
    }],
  }] : []),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={absImage || undefined}
  canonical={post.canonical_url || undefined}
  type="article"
  jsonLd={jsonLd}
  publishedTime={publishedISO}
  section={post.category_name || undefined}
>
  <div class="wrap post-head">
    {post.category_name && <a class="eyebrow cat" href={`/categoria/${post.category_slug}`}>{post.category_name}</a>}
    <h1>{post.title}</h1>
    <div class="post-meta">
      <span>{new Date(post.published_at).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}</span>
      {post.read_time_minutes && <><span>·</span><span>{post.read_time_minutes} min de leitura</span></>}
    </div>
  </div>

  {post.cover_url && (
    <div class="cover wrap">
      <div class="cover-img">
        <img src={post.cover_url} alt={post.alt_text || post.title} width="1200" height="675" loading="eager" fetchpriority="high" />
      </div>
    </div>
  )}

  <div class="wrap">
    <div class="article-layout">
      <article>
        <ArticleAnswerBox slug={post.slug} />
        <Fragment set:html={before} />
        <AdSlot slotKey="in_article" />
        <Fragment set:html={after} />
        <TopicClusterLinks currentSlug={post.slug} />

        <div class="share-block">
          <span class="share-label">Compartilhar</span>
          <div class="share-btns">
            <a
              class="share-btn whatsapp"
              href={`https://wa.me/?text=${encodeURIComponent(post.title + ' ' + postURL)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartilhar no WhatsApp"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.558 4.121 1.532 5.849L.073 23.927l6.263-1.643A11.928 11.928 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.778 9.778 0 01-5.017-1.381l-.36-.213-3.72.976.994-3.634-.234-.373A9.78 9.78 0 012.182 12C2.182 6.57 6.569 2.182 12 2.182S21.818 6.57 21.818 12 17.431 21.818 12 21.818z"/></svg>
              WhatsApp
            </a>
            <a
              class="share-btn facebook"
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postURL)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartilhar no Facebook"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
              Facebook
            </a>
            <a
              class="share-btn telegram"
              href={`https://t.me/share/url?url=${encodeURIComponent(postURL)}&text=${encodeURIComponent(post.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartilhar no Telegram"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              Telegram
            </a>
          </div>
        </div>

        {tags.length > 0 && (
          <div class="tags">
            {tags.map((tag: any) => <span>{tag.name}</span>)}
          </div>
        )}
      </article>

      <aside>
        <div class="side-block">
          <AdSlot slotKey="sidebar_300x600" />
        </div>
        {related.length > 0 && (
          <div class="side-block">
            <h4>Leia também</h4>
            {related.map((r) => (
              <a class="related-item" href={`/${r.slug}`}>
                <div class="related-thumb">
                  {r.thumb_url && <img src={r.thumb_url} alt={r.alt_text || r.title} loading="lazy" width="64" height="64" />}
                </div>
                <h5>{r.title}</h5>
              </a>
            ))}
          </div>
        )}
        <div class="side-block">
          <PriorityStudies currentSlug={post.slug} compact={true} />
        </div>
      </aside>
    </div>

    <div class="comments-section">
      <h3>Comentários {comments.length > 0 && `(${comments.length})`}</h3>

      <form id="comment-form" data-post-id={post.id}>
        <div class="comment-fields">
          <input type="text" id="c-name" placeholder="Seu nome" required />
          <input type="email" id="c-email" placeholder="Seu e-mail (não é exibido)" required />
        </div>
        <textarea id="c-content" rows="3" placeholder="Escreva seu comentário..." required></textarea>
        <button type="submit" id="c-submit">Comentar</button>
        <p id="c-feedback" class="c-feedback" hidden></p>
      </form>

      {comments.length > 0 ? (
        <ul class="comments-list">
          {comments.map((c: any) => (
            <li>
              <div class="c-name">{c.name}</div>
              <div class="c-date">{new Date(c.created_at).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}</div>
              <p>{c.content}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="no-comments">Seja o primeiro a comentar.</p>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { createSupabaseBrowserClient } from '../lib/supabase-browser';
  const supabase = createSupabaseBrowserClient();

  const form = document.getElementById('comment-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('c-submit') as HTMLButtonElement;
    const feedback = document.getElementById('c-feedback') as HTMLParagraphElement;
    btn.disabled = true;
    btn.textContent = 'Enviando...';

    const post_id = form.dataset.postId!;
    const name = (document.getElementById('c-name') as HTMLInputElement).value;
    const email = (document.getElementById('c-email') as HTMLInputElement).value;
    const content = (document.getElementById('c-content') as HTMLTextAreaElement).value;

    const { error } = await supabase.from('comments').insert({ post_id, name, email, content, approved: false });

    if (error) {
      feedback.textContent = 'Não foi possível enviar. Tenta de novo.';
      feedback.hidden = false;
      btn.disabled = false;
      btn.textContent = 'Comentar';
      return;
    }

    form.reset();
    feedback.textContent = 'Comentário enviado! Ele aparece aqui depois de aprovado.';
    feedback.hidden = false;
    btn.textContent = 'Enviado ✓';
  });
</script>

<style>
  .post-head { padding: 44px 0 28px; max-width: 760px; margin: 0 auto; }
  .post-head .cat { color: var(--olive-deep); margin-bottom: 14px; display: block; }
  .post-head h1 { font-family: var(--font-display); font-weight: 500; font-size: 36px; line-height: 1.2; margin: 0 0 18px; }
  .post-meta { font-family: var(--font-ui); font-size: 13px; color: var(--ink-soft); display: flex; gap: 14px; padding-bottom: 24px; border-bottom: 1px solid var(--clay-line); }

  .cover { padding-bottom: 40px; }
  .cover-img { aspect-ratio: 16/9; border-radius: var(--radius); overflow: hidden; background: linear-gradient(155deg,#8B9560,#59613A); }
  .cover-img img { width: 100%; height: 100%; object-fit: cover; }

  .article-layout { display: grid; grid-template-columns: 1fr 300px; gap: 56px; align-items: start; padding-bottom: 60px; }
  article { max-width: 680px; font-size: 17px; }
  article :global(p) { margin-bottom: 20px; }
  article :global(h2) { font-family: var(--font-display); font-weight: 500; font-size: 24px; margin: 36px 0 16px; }
  article :global(h3) { font-family: var(--font-display); font-weight: 500; font-size: 20px; margin: 28px 0 14px; }
  article :global(img) { max-width: 100%; height: auto; border-radius: var(--radius); }
  article :global(a) { color: var(--ember-deep); text-decoration: underline; }

  .share-block { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--clay-line); }
  .share-label { font-family: var(--font-ui); font-size: 11px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: var(--ink-soft); display: block; margin-bottom: 12px; }
  .share-btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .share-btn {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-ui); font-size: 13px; font-weight: 600;
    padding: 9px 16px; border-radius: 6px; text-decoration: none;
    transition: opacity .15s;
  }
  .share-btn:hover { opacity: .85; text-decoration: none; }
  .share-btn.whatsapp  { background: #25D366; color: #fff; }
  .share-btn.facebook  { background: #1877F2; color: #fff; }
  .share-btn.telegram  { background: #229ED9; color: #fff; }

  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .tags span {
    font-family: var(--font-ui); font-size: 12px; background: var(--card-bg); border: 1px solid var(--clay-line);
    color: var(--olive-deep); padding: 6px 12px; border-radius: var(--radius);
  }

  .side-block { margin-bottom: 36px; }
  .side-block h4 { font-family: var(--font-display); font-size: 16px; font-weight: 500; margin: 0 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--clay-line); }
  .related-item { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--clay-line); }
  .related-item:first-child { padding-top: 0; }
  .related-thumb { aspect-ratio: 1/1; border-radius: var(--radius); overflow: hidden; background: linear-gradient(150deg,#c9a862,#8A5E1C); }
  .related-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .related-item h5 { font-family: var(--font-display); font-size: 13px; font-weight: 500; line-height: 1.35; margin: 0; }

  @media (max-width: 860px) {
    .article-layout { grid-template-columns: 1fr; }
  }

  .comments-section { max-width: 680px; margin: 0 auto 60px; padding-top: 20px; border-top: 1px solid var(--clay-line); }
  .comments-section h3 { font-family: var(--font-display); font-weight: 500; font-size: 20px; margin: 0 0 20px; }

  #comment-form { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }
  .comment-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  #comment-form input, #comment-form textarea {
    font-family: var(--font-ui); font-size: 13px; padding: 10px 12px; border: 1px solid var(--clay-line);
    border-radius: 4px; background: var(--card-bg); color: var(--ink); resize: vertical;
  }
  #comment-form input:focus, #comment-form textarea:focus { outline: none; border-color: var(--olive); }
  #comment-form button {
    align-self: flex-start; font-family: var(--font-ui); font-size: 13px; font-weight: 600;
    padding: 9px 20px; border-radius: 4px; border: none; background: var(--olive); color: #fff; cursor: pointer;
  }
  .c-feedback { font-family: var(--font-ui); font-size: 12px; color: var(--olive-deep); margin: 0; }

  .comments-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 20px; }
  .comments-list li { padding-bottom: 20px; border-bottom: 1px solid var(--clay-line); }
  .comments-list li:last-child { border-bottom: none; padding-bottom: 0; }
  .c-name { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--ink); }
  .c-date { font-family: var(--font-ui); font-size: 11px; color: #8A8367; margin-bottom: 8px; }
  .comments-list p { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .no-comments { font-family: var(--font-ui); font-size: 13px; color: #8A8367; }

  @media (max-width: 560px) {
    .comment-fields { grid-template-columns: 1fr; }
  }
</style>
