---
import Header from "../components/Header.astro";
import NewsTicker from "../components/NewsTicker.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import "../styles/tokens.css";
import type { Lang } from "../i18n/translations";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  publishedTime?: string;
  section?: string;
  lang?: Lang;
  slug?: string;
}

const {
  title,
  description = "Estudos bíblicos, escatologia e vida cristã para o dia a dia.",
  image = "/og-default.jpg",
  canonical,
  type = "website",
  jsonLd,
  noindex = false,
  publishedTime,
  section,
  lang = "pt",
  slug,
} = Astro.props;

const siteURL = "https://montedasoliveiras.com";
const altSlug = slug ? `/${slug}` : "/";
const hreflangs = [
  { hreflang: "pt-BR", href: `${siteURL}${altSlug}` },
  { hreflang: "en",    href: `${siteURL}/en${altSlug}` },
  { hreflang: "es",    href: `${siteURL}/es${altSlug}` },
  { hreflang: "x-default", href: `${siteURL}${altSlug}` },
];

const canonicalURL =
  canonical || new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image.startsWith("http") ? image : `${siteURL}${image}`;
const fullTitle =
  title === "Monte das Oliveiras"
    ? "Monte das Oliveiras | Estudos Bíblicos, Escatologia e Vida Cristã"
    : `${title} | Monte das Oliveiras`;
---

<!doctype html>
<html lang={lang === "en" ? "en" : lang === "es" ? "es" : "pt-BR"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="google-site-verification"
      content="XXQFkjDOD2t9oUYJl1Z2-b45tHK9CS6Ov9F-nN10dx0"
    />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <meta name="theme-color" content="#2B3152" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Monte das Oliveiras" />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === "article" && section && (
        <meta property="article:section" content={section} />
      )
    }
    <meta property="article:author" content="https://montedasoliveiras.com" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- fontes: preconnect + carregamento não-bloqueante -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <script define:vars={{ GA_ID: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}>
      // Google Analytics só carrega depois do consentimento (LGPD) — mesma
      // lógica de gate usada nos anúncios
      const CONSENT_KEY = "mdo_ad_consent";

      function loadGA() {
        if (!GA_ID || (window as any).__gaLoaded) return;
        (window as any).__gaLoaded = true;

        const s = document.createElement("script");
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(s);

        (window as any).dataLayer = (window as any).dataLayer || [];
        function gtag() {
          (window as any).dataLayer.push(arguments);
        }
        (window as any).gtag = gtag;
        gtag("js", new Date());
        gtag("config", GA_ID, { anonymize_ip: true });
      }

      if (localStorage.getItem(CONSENT_KEY) === "granted") {
        loadGA();
      }
      window.addEventListener("mdo-consent-granted", loadGA);
    </script>

    <script>
      // Redireciona para o idioma do navegador na primeira visita
      const path = window.location.pathname;
      const isLang = path.startsWith('/en') || path.startsWith('/es') || path.startsWith('/admin');
      if (!isLang) {
        const saved = localStorage.getItem('mdo_lang');
        if (!saved) {
          const br = (navigator.language || navigator.languages?.[0] || 'pt').toLowerCase();
          if (br.startsWith('en')) { localStorage.setItem('mdo_lang','en'); window.location.replace('/en/'); }
          else if (br.startsWith('es')) { localStorage.setItem('mdo_lang','es'); window.location.replace('/es/'); }
          else localStorage.setItem('mdo_lang','pt');
        }
      }
    </script>
  </head>
  <body>
    <Header lang={lang} />
    <NewsTicker />
    <slot />
    <Footer />
    <ConsentBanner />
  </body>
</html>
