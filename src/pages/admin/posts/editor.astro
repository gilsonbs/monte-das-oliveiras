---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Editor de post">
  <div class="topbar">
    <div>
      <a class="back" href="/admin">&larr; Voltar para posts</a>
      <h1 id="page-title">Novo post</h1>
    </div>
    <div class="topbar-actions">
      <span id="save-status" class="btn btn-ghost"></span>
      <button type="button" class="btn" id="btn-preview" hidden>Pré-visualizar</button>
      <button type="button" class="btn btn-danger" id="btn-delete" hidden>Excluir post</button>
      <button type="button" class="btn" id="btn-draft">Salvar rascunho</button>
      <button type="button" class="btn btn-primary" id="btn-publish">Publicar</button>
    </div>
  </div>

  <form id="post-form">
    <div class="editor-layout">
      <div>
        <div class="panel">
          <input class="title-input" type="text" id="title" placeholder="Título do post" required />
          <div class="slug">montedasoliveiras.com/<b><span id="slug-preview"></span></b></div>
          <input type="hidden" id="slug" />
        </div>

        <div class="panel starter-panel" id="starter-panel">
          <div class="starter-head">
            <div>
              <label>Começar artigo novo</label>
              <div class="hint">Monte uma estrutura inicial editável a partir do título.</div>
            </div>
            <button type="button" class="mini-btn" id="btn-build-starter">Criar estrutura</button>
          </div>
          <div class="starter-grid">
            <label class="starter-option">
              <input type="radio" name="starter_type" value="estudo" checked />
              <span>Estudo bíblico</span>
            </label>
            <label class="starter-option">
              <input type="radio" name="starter_type" value="pergunta" />
              <span>Pergunta e resposta</span>
            </label>
            <label class="starter-option">
              <input type="radio" name="starter_type" value="noticia" />
              <span>Notícia comentada</span>
            </label>
          </div>
        </div>

        <div class="panel">
          <label>Conteúdo</label>
          <div class="toolbar" id="toolbar">
            <div class="toolbar-group">
              <button type="button" data-cmd="undo" title="Desfazer" aria-label="Desfazer">↶</button>
              <button type="button" data-cmd="redo" title="Refazer" aria-label="Refazer">↷</button>
            </div>
            <div class="toolbar-group">
              <button type="button" data-cmd="paragraph" title="Parágrafo" aria-label="Parágrafo">P</button>
              <button type="button" data-cmd="h2" title="Título de seção" aria-label="Título de seção">H2</button>
              <button type="button" data-cmd="h3" title="Subtítulo" aria-label="Subtítulo">H3</button>
            </div>
            <div class="toolbar-group">
              <button type="button" data-cmd="bold" title="Negrito" aria-label="Negrito"><b>B</b></button>
              <button type="button" data-cmd="italic" title="Itálico" aria-label="Itálico"><i>I</i></button>
              <button type="button" data-cmd="underline" title="Sublinhado" aria-label="Sublinhado"><u>U</u></button>
              <button type="button" data-cmd="clear" title="Limpar formatação" aria-label="Limpar formatação">Tx</button>
            </div>
            <div class="toolbar-group">
              <button type="button" data-cmd="blockquote" title="Citação" aria-label="Citação">“”</button>
              <button type="button" data-cmd="bulletList" title="Lista com marcadores" aria-label="Lista com marcadores">•</button>
              <button type="button" data-cmd="orderedList" title="Lista numerada" aria-label="Lista numerada">1.</button>
              <button type="button" data-cmd="horizontalRule" title="Separador" aria-label="Separador">—</button>
            </div>
            <div class="toolbar-group">
              <button type="button" data-cmd="link" title="Inserir link" aria-label="Inserir link">↗</button>
              <button type="button" data-cmd="unlink" title="Remover link" aria-label="Remover link">×↗</button>
              <button type="button" data-cmd="image" title="Inserir imagem" aria-label="Inserir imagem">▧</button>
            </div>
            <div class="toolbar-group">
              <button type="button" data-cmd="align-left" title="Alinhar à esquerda" aria-label="Alinhar à esquerda">⇤</button>
              <button type="button" data-cmd="align-center" title="Centralizar" aria-label="Centralizar">↔</button>
              <button type="button" data-cmd="align-right" title="Alinhar à direita" aria-label="Alinhar à direita">⇥</button>
              <button type="button" data-cmd="align-justify" title="Justificar" aria-label="Justificar">☰</button>
            </div>
          </div>
          <div class="editor-helper">
            Use H2 para seções principais, H3 para detalhes e links internos para conectar o artigo ao restante do site.
          </div>
          <input type="file" id="inline-img-input" accept="image/*" hidden />
          <div id="editor" class="tiptap-editor"></div>
          <input type="hidden" id="content" />
        </div>

        <div class="panel">
          <div class="seo-tools">
            <div>
              <label>Assistente de SEO</label>
              <div class="hint">Gere sugestões editáveis a partir do título e do conteúdo.</div>
            </div>
            <button type="button" class="mini-btn" id="btn-fill-all-seo">Preencher tudo</button>
          </div>
          <div class="seo-tool-actions">
            <button type="button" class="mini-btn" id="btn-suggest-excerpt">Resumo</button>
            <button type="button" class="mini-btn" id="btn-suggest-seo-title">Título SEO</button>
            <button type="button" class="mini-btn" id="btn-suggest-meta">Meta descrição</button>
          </div>
          <div class="field">
            <label>Resumo (excerpt)</label>
            <textarea id="excerpt" rows="2"></textarea>
          </div>
          <div class="field">
            <label>Título SEO</label>
            <input type="text" id="seo_title" />
          </div>
          <div class="field" style="margin-bottom:0;">
            <label>Meta descrição</label>
            <textarea id="meta_description" rows="2"></textarea>
          </div>
        </div>
      </div>

      <div>
        <div class="panel">
          <label>Imagem de capa</label>
          <div class="upload-zone" id="upload-zone">
            <div class="icon">↑</div>
            <div class="title" id="upload-title">Arraste uma imagem ou clique para enviar</div>
            <div class="hint">Qualquer tamanho — o recorte é automático</div>
          </div>
          <input type="file" id="file-input" accept="image/*" hidden />
          <input type="hidden" id="cover_media_id" />
          <div class="cover-guidance">
            <div class="field">
              <label>Texto alternativo da capa</label>
              <input type="text" id="cover_alt_text" placeholder="Descreva a imagem para acessibilidade e SEO" />
            </div>
            <button type="button" class="mini-btn" id="btn-suggest-cover-alt">Sugerir alt text</button>
            <div class="cover-checklist">
              <div class="cover-check" id="cover-size-check"><span></span>Imagem com pelo menos 1200px de largura</div>
              <div class="cover-check" id="cover-alt-check"><span></span>Alt text claro e preenchido</div>
            </div>
          </div>

          <div class="formats-generated" id="formats-generated" hidden>
            <div class="formats-label"><span class="check">✓</span>4 formatos gerados</div>
            <div class="formats-grid" id="formats-grid"></div>
          </div>

          <div class="formats-generated" id="existing-formats" hidden>
            <div class="formats-label"><span class="check">✓</span>Capa atual</div>
            <div class="formats-grid">
              <div class="format-card"><img id="existing-cover-img" src="" alt="" /></div>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="field">
            <label>Categoria</label>
            <select id="category_id"></select>
          </div>
          <div class="field" style="margin-bottom:0;">
            <label>Tags (separadas por vírgula)</label>
            <input type="text" id="tags" placeholder="fé, esperança, profecia" />
          </div>
        </div>

        <div class="panel internal-links-panel">
          <label>Links internos</label>
          <input type="text" id="internal-link-search" placeholder="Buscar artigo para linkar" />
          <div class="hint">Selecione um texto no artigo e clique em um resultado, ou clique direto para inserir o título com link.</div>
          <div class="internal-link-results" id="internal-link-results">
            <div class="empty">Carregando artigos...</div>
          </div>
        </div>

        <div class="panel seo-assistant" id="seo-assistant">
          <div class="seo-assistant-head">
            <div>
              <label>Checklist de publicação</label>
              <div class="seo-score" id="seo-score">0 de 9 pontos prontos</div>
            </div>
            <span class="seo-badge" id="seo-badge">Rascunho</span>
          </div>
          <div class="seo-progress"><span id="seo-progress-bar"></span></div>
          <ul class="seo-checklist" id="seo-checklist">
            <li data-check="title"><span></span>Título com 35 a 70 caracteres</li>
            <li data-check="slug"><span></span>URL curta e legível</li>
            <li data-check="excerpt"><span></span>Resumo preenchido</li>
            <li data-check="seoTitle"><span></span>Título SEO preenchido</li>
            <li data-check="meta"><span></span>Meta descrição com 120 a 160 caracteres</li>
            <li data-check="cover"><span></span>Imagem de capa definida</li>
            <li data-check="coverAlt"><span></span>Texto alternativo da capa preenchido</li>
            <li data-check="headings"><span></span>Conteúdo com subtítulos H2/H3</li>
            <li data-check="internalLinks"><span></span>Pelo menos 2 links internos</li>
          </ul>
          <div class="seo-tip" id="seo-tip">Preencha o título para começar a acompanhar a qualidade do post.</div>
          <div class="publish-warning" id="publish-warning" hidden></div>
        </div>

        <div class="panel">
          <div class="toggle-row">
            <div>
              <div class="lbl">Destacar na home</div>
              <div class="sub">Aparece no bloco de abertura</div>
            </div>
            <label class="switch-wrap">
              <input type="checkbox" id="is_featured" />
              <span class="switch"></span>
            </label>
          </div>
        </div>
      </div>
    </div>
  </form>
</AdminLayout>

<script>
  import { createSupabaseBrowserClient } from '../../../lib/supabase-browser';
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Link from '@tiptap/extension-link';
  import ImageExt from '@tiptap/extension-image';
  import Underline from '@tiptap/extension-underline';
  import TextAlign from '@tiptap/extension-text-align';

  const supabase = createSupabaseBrowserClient();
  const postId = new URLSearchParams(window.location.search).get('id');
  const isNew = !postId;

  // ---------- slug automático a partir do título ----------
  function slugify(text: string) {
    return text
      .toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .trim()
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-');
  }

  const titleInput = document.getElementById('title') as HTMLInputElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;
  const slugPreview = document.getElementById('slug-preview') as HTMLElement;
  const excerptInput = document.getElementById('excerpt') as HTMLTextAreaElement;
  const seoTitleInput = document.getElementById('seo_title') as HTMLInputElement;
  const metaDescriptionInput = document.getElementById('meta_description') as HTMLTextAreaElement;
  const coverMediaInput = document.getElementById('cover_media_id') as HTMLInputElement;
  const coverAltInput = document.getElementById('cover_alt_text') as HTMLInputElement;
  let coverMeetsSizeGuidance = false;

  if (isNew) {
    titleInput.addEventListener('input', () => {
      const slug = slugify(titleInput.value);
      slugInput.value = slug;
      slugPreview.textContent = slug;
      if (!coverAltInput.value.trim()) coverAltInput.value = buildCoverAltSuggestion();
      updateSeoChecklist();
    });
  }

  // ---------- editor visual (Tiptap) ----------
  const contentHidden = document.getElementById('content') as HTMLInputElement;
  const editor = new Editor({
    element: document.getElementById('editor')!,
    extensions: [
      StarterKit,
      Link.configure({ openOnClick: false }),
      ImageExt,
      Underline,
      TextAlign.configure({
        types: ['heading', 'paragraph'],
      }),
    ],
    content: '<p></p>',
    onUpdate: ({ editor }) => {
      contentHidden.value = editor.getHTML();
      updateSeoChecklist();
    },
    onTransaction: () => {
      updateToolbarActiveStates();
    },
  });

  function updateToolbarActiveStates() {
    const buttons = document.querySelectorAll('#toolbar button[data-cmd]');
    buttons.forEach((btnEl) => {
      const btn = btnEl as HTMLButtonElement;
      const cmd = btn.dataset.cmd;
      let active = false;

      if (cmd === 'bold') active = editor.isActive('bold');
      else if (cmd === 'italic') active = editor.isActive('italic');
      else if (cmd === 'underline') active = editor.isActive('underline');
      else if (cmd === 'paragraph') active = editor.isActive('paragraph');
      else if (cmd === 'h2') active = editor.isActive('heading', { level: 2 });
      else if (cmd === 'h3') active = editor.isActive('heading', { level: 3 });
      else if (cmd === 'blockquote') active = editor.isActive('blockquote');
      else if (cmd === 'bulletList') active = editor.isActive('bulletList');
      else if (cmd === 'orderedList') active = editor.isActive('orderedList');
      else if (cmd === 'link' || cmd === 'unlink') active = editor.isActive('link');
      else if (cmd === 'align-left') active = editor.isActive({ textAlign: 'left' });
      else if (cmd === 'align-center') active = editor.isActive({ textAlign: 'center' });
      else if (cmd === 'align-right') active = editor.isActive({ textAlign: 'right' });
      else if (cmd === 'align-justify') active = editor.isActive({ textAlign: 'justify' });

      if (active) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  document.getElementById('toolbar')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-cmd]') as HTMLButtonElement | null;
    if (!btn) return;
    const cmd = btn.dataset.cmd;
    const chain = editor.chain().focus();

    if (cmd === 'undo') editor.chain().focus().undo().run();
    else if (cmd === 'redo') editor.chain().focus().redo().run();
    else if (cmd === 'paragraph') chain.setParagraph().run();
    else if (cmd === 'bold') chain.toggleBold().run();
    else if (cmd === 'italic') chain.toggleItalic().run();
    else if (cmd === 'underline') chain.toggleUnderline().run();
    else if (cmd === 'clear') chain.unsetAllMarks().clearNodes().run();
    else if (cmd === 'h2') chain.toggleHeading({ level: 2 }).run();
    else if (cmd === 'h3') chain.toggleHeading({ level: 3 }).run();
    else if (cmd === 'blockquote') chain.toggleBlockquote().run();
    else if (cmd === 'bulletList') chain.toggleBulletList().run();
    else if (cmd === 'orderedList') chain.toggleOrderedList().run();
    else if (cmd === 'horizontalRule') chain.setHorizontalRule().run();
    else if (cmd === 'align-left') chain.setTextAlign('left').run();
    else if (cmd === 'align-center') chain.setTextAlign('center').run();
    else if (cmd === 'align-right') chain.setTextAlign('right').run();
    else if (cmd === 'align-justify') chain.setTextAlign('justify').run();
    else if (cmd === 'link') {
      const previousUrl = editor.getAttributes('link').href || '';
      const url = window.prompt('URL do link:', previousUrl);
      if (url) chain.setLink({ href: url }).run();
      else chain.run();
    }
    else if (cmd === 'unlink') {
      chain.unsetLink().run();
    }
    else if (cmd === 'image') {
      (document.getElementById('inline-img-input') as HTMLInputElement).click();
    }
  });

  // upload de imagem inline no conteúdo
  const inlineImgInput = document.getElementById('inline-img-input') as HTMLInputElement;
  inlineImgInput.addEventListener('change', async () => {
    const file = inlineImgInput.files?.[0];
    if (!file) return;
    inlineImgInput.value = '';

    const slug = slugInput.value || slugify(titleInput.value) || 'inline';
    const path = `${slug}/inline-${Date.now()}.webp`;

    // converte para webp via canvas (max 1200px de largura)
    const img = new Image();
    img.src = URL.createObjectURL(file);
    await img.decode();

    const maxW = 1200;
    const scale = img.width > maxW ? maxW / img.width : 1;
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(img.width * scale);
    canvas.height = Math.round(img.height * scale);
    canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
    const blob: Blob = await new Promise((res, rej) =>
      canvas.toBlob((b) => (b ? res(b) : rej(new Error('Erro ao gerar imagem'))), 'image/webp', 0.85)
    );

    const { error } = await supabase.storage.from('media').upload(path, blob, {
      contentType: 'image/webp',
      upsert: true,
    });
    if (error) { alert(`Erro ao enviar imagem: ${error.message}`); return; }

    const { data } = supabase.storage.from('media').getPublicUrl(path);
    editor.chain().focus().setImage({ src: data.publicUrl }).run();
  });

  // ---------- pipeline de imagem (equivalente ao sharp, via Canvas) ----------
  const VARIANTS: Record<string, { w: number; h: number }> = {
    cover: { w: 1200, h: 675 },
    card: { w: 800, h: 600 },
    thumb: { w: 400, h: 400 },
    share: { w: 1200, h: 630 },
  };

  function cropToCanvas(img: HTMLImageElement, w: number, h: number): HTMLCanvasElement {
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d')!;
    const scale = Math.max(w / img.width, h / img.height);
    const sw = w / scale;
    const sh = h / scale;
    const sx = (img.width - sw) / 2;
    const sy = (img.height - sh) / 2;
    ctx.drawImage(img, sx, sy, sw, sh, 0, 0, w, h);
    return canvas;
  }

  function canvasToWebpBlob(canvas: HTMLCanvasElement): Promise<Blob> {
    return new Promise((resolve, reject) => {
      canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('Falha ao gerar imagem'))), 'image/webp', 0.82);
    });
  }

  let pendingCoverFile: File | null = null;

  const uploadZone = document.getElementById('upload-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const formatsGenerated = document.getElementById('formats-generated')!;
  const formatsGrid = document.getElementById('formats-grid')!;
  const uploadTitle = document.getElementById('upload-title')!;
  const internalLinkSearch = document.getElementById('internal-link-search') as HTMLInputElement;
  const internalLinkResults = document.getElementById('internal-link-results')!;
  let internalLinkPosts: { title: string; slug: string; status?: string | null }[] = [];

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function insertInternalLink(title: string, slug: string) {
    const href = `/${slug}/`;
    const selectedText = editor.state.doc.textBetween(
      editor.state.selection.from,
      editor.state.selection.to,
      ' '
    ).trim();

    if (selectedText) {
      editor.chain().focus().setLink({ href }).run();
    } else {
      editor.chain().focus().insertContent(`<a href="${href}">${title}</a>`).run();
    }
    updateSeoChecklist();
  }

  function renderInternalLinkResults(query = '') {
    const normalized = query.trim().toLowerCase();
    const currentSlug = slugInput.value.trim();
    const results = internalLinkPosts
      .filter((post) => post.slug !== currentSlug)
      .filter((post) => {
        if (!normalized) return true;
        return post.title.toLowerCase().includes(normalized) || post.slug.toLowerCase().includes(normalized);
      })
      .slice(0, 8);

    if (!results.length) {
      internalLinkResults.innerHTML = '<div class="empty">Nenhum artigo encontrado.</div>';
      return;
    }

    internalLinkResults.innerHTML = results.map((post) => `
      <button type="button" class="internal-link-item" data-slug="${escapeHtml(post.slug)}" data-title="${escapeHtml(post.title)}">
        <strong>${escapeHtml(post.title)}</strong>
        <span>/${escapeHtml(post.slug)}/</span>
      </button>
    `).join('');
  }

  internalLinkSearch.addEventListener('input', () => renderInternalLinkResults(internalLinkSearch.value));
  internalLinkResults.addEventListener('click', (event) => {
    const item = (event.target as HTMLElement).closest('.internal-link-item') as HTMLButtonElement | null;
    if (!item) return;
    insertInternalLink(item.dataset.title || '', item.dataset.slug || '');
  });

  function textLength(value: string) {
    return value.trim().replace(/\s+/g, ' ').length;
  }

  function getPlainArticleParts() {
    const html = contentHidden.value || editor.getHTML();
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const paragraphs = Array.from(doc.querySelectorAll('p'))
      .map((node) => node.textContent?.trim().replace(/\s+/g, ' ') || '')
      .filter((text) => text.length > 35);
    const headings = Array.from(doc.querySelectorAll('h2, h3'))
      .map((node) => node.textContent?.trim().replace(/\s+/g, ' ') || '')
      .filter(Boolean);
    const allText = [titleInput.value, ...headings, ...paragraphs].join(' ').trim().replace(/\s+/g, ' ');
    return { paragraphs, headings, allText };
  }

  function limitText(value: string, max: number) {
    const clean = value.trim().replace(/\s+/g, ' ');
    if (clean.length <= max) return clean;
    const sliced = clean.slice(0, max + 1);
    const lastSpace = sliced.lastIndexOf(' ');
    return `${sliced.slice(0, lastSpace > 60 ? lastSpace : max).replace(/[,.!?;:]$/, '')}...`;
  }

  function buildExcerptSuggestion() {
    const { paragraphs, headings } = getPlainArticleParts();
    const firstParagraph = paragraphs[0] || '';
    const support = headings[0] ? ` O artigo também aborda ${headings[0].toLowerCase()}.` : '';
    const fallback = titleInput.value
      ? `Entenda ${titleInput.value.toLowerCase()} com uma explicação bíblica clara, prática e organizada para fortalecer sua fé.`
      : 'Escreva um resumo claro do artigo, destacando o tema principal e o benefício para o leitor.';
    return limitText(`${firstParagraph || fallback}${support}`, 220);
  }

  function buildSeoTitleSuggestion() {
    const base = titleInput.value.trim() || 'Estudo bíblico';
    const withoutSite = base.replace(/\s*\|\s*Monte das Oliveiras$/i, '').replace(/\s+-\s+Monte das Oliveiras$/i, '');
    if (withoutSite.length >= 35 && withoutSite.length <= 58) return withoutSite;
    if (withoutSite.length < 35) return limitText(`${withoutSite}: estudo bíblico completo`, 58);
    return limitText(withoutSite, 58);
  }

  function buildMetaDescriptionSuggestion() {
    const excerpt = buildExcerptSuggestion();
    const base = excerpt.length >= 120
      ? excerpt
      : `${excerpt} Veja uma explicação bíblica clara, com aplicações práticas e orientação para a vida cristã.`;
    return limitText(base, 158);
  }

  function buildCoverAltSuggestion() {
    const title = titleInput.value.trim();
    if (!title) return '';
    return limitText(`Imagem ilustrativa do artigo sobre ${title.toLowerCase()}`, 120);
  }

  function getStarterType() {
    return (document.querySelector('input[name="starter_type"]:checked') as HTMLInputElement | null)?.value || 'estudo';
  }

  function buildStarterContent() {
    const title = titleInput.value.trim() || 'este tema';
    const lowerTitle = title.toLowerCase();
    const type = getStarterType();
    const intro = `Este artigo apresenta uma explicação bíblica sobre ${lowerTitle}, com uma resposta direta, contexto e aplicações práticas para a vida cristã.`;

    if (type === 'pergunta') {
      return `
        <p><strong>Resposta rápida:</strong> ${title} deve ser entendido à luz da Bíblia, considerando o contexto, os princípios cristãos e a direção espiritual para cada situação.</p>
        <p>${intro}</p>
        <h2>O que a Bíblia ensina sobre ${lowerTitle}?</h2>
        <p>Desenvolva aqui a resposta principal, citando textos bíblicos importantes e explicando o sentido com clareza.</p>
        <h2>Como aplicar esse ensino hoje?</h2>
        <p>Mostre como esse tema conversa com decisões, dúvidas e desafios reais da vida cristã.</p>
        <h2>Cuidados importantes ao interpretar esse assunto</h2>
        <p>Explique limites, erros comuns e pontos que precisam de equilíbrio pastoral.</p>
        <h2>Conclusão</h2>
        <p>Feche retomando a resposta central e orientando o leitor para uma atitude prática de fé.</p>
      `;
    }

    if (type === 'noticia') {
      return `
        <p><strong>Resposta rápida:</strong> ${title} merece atenção cristã, mas precisa ser avaliado com prudência, contexto bíblico e discernimento espiritual.</p>
        <p>${intro}</p>
        <h2>O que aconteceu?</h2>
        <p>Resuma os fatos principais de forma objetiva, separando informação confirmada de interpretação.</p>
        <h2>Por que isso importa para os cristãos?</h2>
        <p>Explique a relevância espiritual, social ou profética do tema sem exageros.</p>
        <h2>Como olhar para esse assunto biblicamente?</h2>
        <p>Conecte o tema a princípios bíblicos, textos relevantes e discernimento cristão.</p>
        <h2>Como devemos responder?</h2>
        <p>Oriente o leitor com passos práticos: oração, prudência, serviço, esperança e fidelidade.</p>
      `;
    }

    return `
      <p><strong>Resposta rápida:</strong> ${title} é um tema importante para compreender melhor a fé cristã, a mensagem bíblica e sua aplicação prática hoje.</p>
      <p>${intro}</p>
      <h2>O significado bíblico de ${lowerTitle}</h2>
      <p>Explique o conceito principal, trazendo o contexto bíblico e o sentido do tema.</p>
      <h2>Principais textos bíblicos sobre o tema</h2>
      <p>Liste e explique as passagens mais importantes, mostrando como elas se conectam.</p>
      <h2>Lições espirituais para a vida cristã</h2>
      <p>Mostre como o ensino se aplica à fé, à oração, à obediência e ao relacionamento com Deus.</p>
      <h2>Conclusão</h2>
      <p>Reforce a ideia central e convide o leitor a viver esse princípio de forma prática.</p>
    `;
  }

  function applyStarterContent() {
    const currentText = editor.getText().trim();
    if (currentText.length > 20 && !confirm('O conteúdo atual será substituído pela estrutura inicial. Deseja continuar?')) return;

    const starterContent = buildStarterContent();
    editor.commands.setContent(starterContent);
    contentHidden.value = editor.getHTML();
    applySeoSuggestion('all');
    if (!coverAltInput.value.trim()) coverAltInput.value = buildCoverAltSuggestion();
    updateSeoChecklist();
  }

  function applySeoSuggestion(target: 'excerpt' | 'seoTitle' | 'meta' | 'all') {
    if (target === 'excerpt' || target === 'all') excerptInput.value = buildExcerptSuggestion();
    if (target === 'seoTitle' || target === 'all') seoTitleInput.value = buildSeoTitleSuggestion();
    if (target === 'meta' || target === 'all') metaDescriptionInput.value = buildMetaDescriptionSuggestion();
    updateSeoChecklist();
  }

  document.getElementById('btn-suggest-excerpt')?.addEventListener('click', () => applySeoSuggestion('excerpt'));
  document.getElementById('btn-suggest-seo-title')?.addEventListener('click', () => applySeoSuggestion('seoTitle'));
  document.getElementById('btn-suggest-meta')?.addEventListener('click', () => applySeoSuggestion('meta'));
  document.getElementById('btn-fill-all-seo')?.addEventListener('click', () => applySeoSuggestion('all'));
  document.getElementById('btn-build-starter')?.addEventListener('click', applyStarterContent);
  document.getElementById('btn-suggest-cover-alt')?.addEventListener('click', () => {
    coverAltInput.value = buildCoverAltSuggestion();
    updateSeoChecklist();
  });
  coverAltInput.addEventListener('input', updateSeoChecklist);

  function countInternalLinks() {
    const html = contentHidden.value || editor.getHTML();
    const doc = new DOMParser().parseFromString(html, 'text/html');
    return Array.from(doc.querySelectorAll('a[href]')).filter((link) => {
      const href = link.getAttribute('href') || '';
      return href.startsWith('/') || href.includes('montedasoliveiras.com');
    }).length;
  }

  type PublicationCheck = { ok: boolean; label: string; tip: string };

  function getPublicationChecks(): Record<string, PublicationCheck> {
    const html = contentHidden.value || editor.getHTML();
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const titleLength = textLength(titleInput.value);
    const metaLength = textLength(metaDescriptionInput.value);
    const slug = slugInput.value.trim();
    return {
      title: {
        ok: titleLength >= 35 && titleLength <= 70,
        label: 'Título com 35 a 70 caracteres',
        tip: 'Ajuste o título para ficar claro, pesquisável e nem curto nem longo demais.',
      },
      slug: {
        ok: slug.length >= 8 && slug.length <= 75 && !slug.includes('--'),
        label: 'URL curta e legível',
        tip: 'Use uma URL curta, sem palavras sobrando, separada por hífens.',
      },
      excerpt: {
        ok: textLength(excerptInput.value) >= 80,
        label: 'Resumo preenchido',
        tip: 'Escreva um resumo objetivo para orientar o leitor e ajudar na listagem do site.',
      },
      seoTitle: {
        ok: textLength(seoTitleInput.value) >= 35,
        label: 'Título SEO preenchido',
        tip: 'Preencha o título SEO com a promessa principal do artigo.',
      },
      meta: {
        ok: metaLength >= 120 && metaLength <= 160,
        label: 'Meta descrição com 120 a 160 caracteres',
        tip: `A meta descrição está com ${metaLength} caracteres; mire entre 120 e 160.`,
      },
      cover: {
        ok: !!coverMediaInput.value || !!pendingCoverFile,
        label: 'Imagem de capa definida',
        tip: 'Adicione uma imagem de capa antes de publicar.',
      },
      coverAlt: {
        ok: textLength(coverAltInput.value) >= 25,
        label: 'Texto alternativo da capa preenchido',
        tip: 'Preencha um texto alternativo claro para a imagem de capa.',
      },
      headings: {
        ok: doc.querySelectorAll('h2, h3').length >= 2,
        label: 'Conteúdo com subtítulos H2/H3',
        tip: 'Divida o conteúdo com pelo menos dois subtítulos H2 ou H3.',
      },
      internalLinks: {
        ok: countInternalLinks() >= 2,
        label: 'Pelo menos 2 links internos',
        tip: 'Inclua pelo menos dois links para outros artigos do próprio site.',
      },
    };
  }

  function getPublicationGaps() {
    return Object.values(getPublicationChecks()).filter((check) => !check.ok);
  }

  function updateSeoChecklist() {
    const checks = getPublicationChecks();

    const entries = Object.entries(checks).map(([key, check]) => [key, check.ok] as const);
    const passed = entries.filter(([, ok]) => ok).length;
    const total = entries.length;
    const percent = Math.round((passed / total) * 100);

    for (const [key, ok] of entries) {
      const item = document.querySelector(`[data-check="${key}"]`);
      item?.classList.toggle('done', ok);
    }

    document.getElementById('seo-score')!.textContent = `${passed} de ${total} pontos prontos`;
    (document.getElementById('seo-progress-bar') as HTMLElement).style.width = `${percent}%`;

    const badge = document.getElementById('seo-badge')!;
    badge.textContent = percent >= 85 ? 'Pronto' : percent >= 60 ? 'Quase' : 'Rascunho';
    badge.className = `seo-badge ${percent >= 85 ? 'ready' : percent >= 60 ? 'almost' : ''}`;

    const next = Object.values(checks).find((check) => !check.ok);
    document.getElementById('seo-tip')!.textContent = next ? next.tip : 'Checklist pronto para publicação. Faça uma última leitura antes de publicar.';

    document.getElementById('cover-alt-check')?.classList.toggle('done', checks.coverAlt.ok);
    document.getElementById('cover-size-check')?.classList.toggle('done', coverMeetsSizeGuidance || !!coverMediaInput.value);

    const warning = document.getElementById('publish-warning')!;
    const gaps = getPublicationGaps();
    warning.hidden = gaps.length === 0;
    warning.innerHTML = gaps.length
      ? `<b>Antes de publicar:</b> ${gaps.slice(0, 3).map((gap) => escapeHtml(gap.label)).join(', ')}${gaps.length > 3 ? ` e mais ${gaps.length - 3} ponto(s).` : '.'}`
      : '';
  }

  [excerptInput, seoTitleInput, metaDescriptionInput].forEach((input) => {
    input.addEventListener('input', updateSeoChecklist);
  });

  uploadZone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    pendingCoverFile = file;
    uploadTitle.textContent = 'Processando...';

    const img = new Image();
    img.src = URL.createObjectURL(file);
    await img.decode();
    coverMeetsSizeGuidance = img.width >= 1200;

    formatsGrid.innerHTML = '';
    for (const [name, { w, h }] of Object.entries(VARIANTS)) {
      const canvas = cropToCanvas(img, w, h);
      const card = document.createElement('div');
      card.className = 'format-card';
      card.appendChild(canvas);
      canvas.style.width = '100%';
      canvas.style.height = '100%';
      canvas.style.display = 'block';
      formatsGrid.appendChild(card);
    }
    formatsGenerated.hidden = false;
    uploadTitle.textContent = 'Trocar imagem';
    if (!coverAltInput.value.trim()) coverAltInput.value = buildCoverAltSuggestion();
    updateSeoChecklist();
  });

  async function uploadCoverImage(slug: string): Promise<string | null> {
    if (!pendingCoverFile) return (document.getElementById('cover_media_id') as HTMLInputElement).value || null;

    const img = new Image();
    img.src = URL.createObjectURL(pendingCoverFile);
    await img.decode();

    const urls: Record<string, string> = {};
    for (const [name, { w, h }] of Object.entries(VARIANTS)) {
      const canvas = cropToCanvas(img, w, h);
      const blob = await canvasToWebpBlob(canvas);
      const path = `${slug}/${name}-${Date.now()}.webp`;
      const { error: upErr } = await supabase.storage.from('media').upload(path, blob, {
        contentType: 'image/webp',
        upsert: true,
      });
      if (upErr) throw upErr;
      const { data } = supabase.storage.from('media').getPublicUrl(path);
      urls[name] = data.publicUrl;
    }

    const { data: mediaRow, error: mediaErr } = await supabase
      .from('media')
      .insert({
        original_url: urls.cover,
        cover_url: urls.cover,
        card_url: urls.card,
        thumb_url: urls.thumb,
        share_url: urls.share,
        alt_text: coverAltInput.value.trim() || titleInput.value,
      })
      .select('id')
      .single();
    if (mediaErr) throw mediaErr;
    return mediaRow.id;
  }

  // ---------- categorias/tags ----------
  async function upsertTagsAndLink(postId: string, tagsText: string) {
    const rawNames = tagsText.split(',').map((t) => t.trim()).filter(Boolean);
    const names = [...new Set(rawNames)];
    await supabase.from('post_tags').delete().eq('post_id', postId);

    for (const name of names) {
      const slug = slugify(name);
      const { data: existing } = await supabase.from('tags').select('id').eq('slug', slug).maybeSingle();
      let tagId = existing?.id;
      if (!tagId) {
        const { data: created, error } = await supabase.from('tags').insert({ name, slug }).select('id').single();
        if (error) throw error;
        tagId = created.id;
      }
      await supabase.from('post_tags').insert({ post_id: postId, tag_id: tagId });
    }
  }

  // ---------- salvar (rascunho ou publicado) ----------
  let currentPostId = postId;

  async function savePost(status: 'draft' | 'published') {
    const saveStatus = document.getElementById('save-status')!;
    saveStatus.textContent = 'Salvando...';

    const { data: sessionCheck, error: sessionErr } = await supabase.auth.getSession();
    console.log(
      '[diagnostico-sessao-editor] temSessao=' + !!sessionCheck.session +
      ' | usuario=' + (sessionCheck.session?.user?.email || 'nenhum') +
      ' | erro=' + (sessionErr?.message || 'nenhum')
    );

    try {
      if (status === 'published') {
        const gaps = getPublicationGaps();
        if (gaps.length) {
          saveStatus.textContent = '';
          const gapList = gaps.map((gap) => `- ${gap.label}`).join('\n');
          if (!confirm(`Ainda faltam pontos importantes antes da publicação:\n\n${gapList}\n\nDeseja publicar mesmo assim?`)) return;
          saveStatus.textContent = 'Salvando...';
        }
      }

      const slug = slugInput.value || slugify(titleInput.value);
      const coverMediaId = await uploadCoverImage(slug);

      const payload: Record<string, any> = {
        title: titleInput.value,
        slug,
        content: contentHidden.value,
        excerpt: (document.getElementById('excerpt') as HTMLTextAreaElement).value,
        seo_title: (document.getElementById('seo_title') as HTMLInputElement).value || null,
        meta_description: (document.getElementById('meta_description') as HTMLTextAreaElement).value || null,
        category_id: (document.getElementById('category_id') as HTMLSelectElement).value,
        is_featured: (document.getElementById('is_featured') as HTMLInputElement).checked,
        cover_media_id: coverMediaId,
        status,
        published_at: status === 'published' ? new Date().toISOString() : null,
      };

      let savedId = currentPostId;

      if (!savedId) {
        const { data, error } = await supabase.from('posts').insert(payload).select('id').single();
        if (error) throw error;
        savedId = data.id;
      } else {
        const { error } = await supabase.from('posts').update(payload).eq('id', savedId);
        if (error) throw error;
      }

      const tagsText = (document.getElementById('tags') as HTMLInputElement).value;
      await upsertTagsAndLink(savedId!, tagsText);

      saveStatus.textContent = 'Salvo!';
      currentPostId = savedId!;
      const previewBtn = document.getElementById('btn-preview') as HTMLButtonElement;
      previewBtn.hidden = false;
      previewBtn.onclick = () => window.open(`/admin/preview/?id=${savedId}`, '_blank');

      if (status === 'published') {
        const hookUrl = import.meta.env.PUBLIC_VERCEL_DEPLOY_HOOK_URL;
        if (hookUrl) {
          saveStatus.textContent = 'Publicando...';
          await fetch(hookUrl, { method: 'POST' }).catch(() => {});
          saveStatus.textContent = 'Publicado! O site será atualizado em ~1 min.';
        }
      }

      window.location.href = `/admin/posts/editor?id=${savedId}`;
    } catch (err: any) {
      saveStatus.textContent = '';
      alert(`Erro ao salvar: ${err.message || err}`);
    }
  }

  document.getElementById('btn-draft')?.addEventListener('click', () => savePost('draft'));
  document.getElementById('btn-publish')?.addEventListener('click', () => savePost('published'));
  document.getElementById('btn-preview')?.addEventListener('click', () => {
    if (!currentPostId) {
      alert('Salve o rascunho antes de pré-visualizar.');
      return;
    }
    window.open(`/admin/preview/?id=${currentPostId}`, '_blank');
  });

  document.getElementById('btn-delete')?.addEventListener('click', async () => {
    if (!currentPostId) return;
    if (!confirm(`Excluir "${titleInput.value}"? Essa ação não pode ser desfeita.`)) return;

    const { error } = await supabase.from('posts').delete().eq('id', currentPostId);
    if (error) {
      alert(`Erro ao excluir: ${error.message}`);
    } else {
      window.location.href = '/admin/';
    }
  });

  // ---------- carregamento inicial (categorias + post existente, se houver) ----------
  async function init() {
    const { data: categories } = await supabase
      .from('categories')
      .select('id, name, slug')
      .order('name');
    const categorySelect = document.getElementById('category_id') as HTMLSelectElement;
    categorySelect.innerHTML = (categories ?? [])
      .map((c: any) => `<option value="${c.id}">${c.name}</option>`)
      .join('');

    const { data: linkPosts } = await supabase
      .from('posts')
      .select('title, slug, status')
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(80);
    internalLinkPosts = (linkPosts ?? []).filter((post: any) => post.title && post.slug);
    renderInternalLinkResults();

    if (!isNew) {
      const { data: post } = await supabase
        .from('posts')
        .select('*, media(cover_url, card_url, thumb_url, share_url, alt_text)')
        .eq('id', postId)
        .maybeSingle();

      if (!post) {
        window.location.href = '/admin/';
        return;
      }

      document.getElementById('page-title')!.textContent = 'Editar post';
      document.getElementById('btn-delete')!.hidden = false;
      document.getElementById('btn-preview')!.hidden = false;
      document.getElementById('starter-panel')!.hidden = true;
      titleInput.value = post.title;
      slugInput.value = post.slug;
      slugPreview.textContent = post.slug;
      editor.commands.setContent(post.content || '<p></p>');
      contentHidden.value = post.content || '';
      excerptInput.value = post.excerpt || '';
      seoTitleInput.value = post.seo_title || '';
      metaDescriptionInput.value = post.meta_description || '';
      (document.getElementById('is_featured') as HTMLInputElement).checked = !!post.is_featured;
      coverMediaInput.value = post.cover_media_id || '';
      coverAltInput.value = post.media?.alt_text || post.title || '';
      if (post.category_id) categorySelect.value = post.category_id;

      if (post.media?.card_url) {
        (document.getElementById('existing-cover-img') as HTMLImageElement).src = post.media.card_url;
        document.getElementById('existing-formats')!.hidden = false;
      }

      const { data: tagRows } = await supabase.from('post_tags').select('tags(name)').eq('post_id', postId);
      const tagNames = (tagRows ?? []).map((r: any) => r.tags?.name).filter(Boolean).join(', ');
      (document.getElementById('tags') as HTMLInputElement).value = tagNames;
    } else {
      document.getElementById('page-title')!.textContent = 'Novo post';
      document.getElementById('starter-panel')!.hidden = false;
    }
    updateSeoChecklist();
  }

  init();
</script>

<style>
