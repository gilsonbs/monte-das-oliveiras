---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getPostsByTag, getTagBySlug, getTags } from '../../../lib/supabase';

const PER_PAGE = 12;
const page = 1;

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({ params: { slug: tag.slug } }));
}

const { slug } = Astro.params;
const tag = await getTagBySlug(slug!);

if (!tag) {
  return Astro.redirect('/404');
}

const { posts, total } = await getPostsByTag(slug!, page, PER_PAGE);
const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));

const siteURL = 'https://montedasoliveiras.com';
const tagURL = `${siteURL}/tag/${slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: tag.name,
    description: `Artigos marcados com ${tag.name} no Monte das Oliveiras`,
    url: tagURL,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: tag.name,
    url: tagURL,
    numberOfItems: total,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${siteURL}/${post.slug}/`,
      name: post.title,
    })),
  },
];
---

<BaseLayout
  title={`${tag.name} — Artigos | Monte das Oliveiras`}
  description={`Artigos sobre ${tag.name} — estudos bíblicos e vida cristã no Monte das Oliveiras.`}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <div class="page-head">
      <span class="eyebrow">Tag</span>
      <h1>{tag.name}</h1>
      <p class="count">{total} {total === 1 ? 'publicação' : 'publicações'}</p>
    </div>

    <div class="layout">
      <div class="grid-col">
        <div class="grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>

        {totalPages > 1 && (
          <nav class="pagination">
            <span>Página 1 de {totalPages}</span>
            <a href={`/tag/${slug}/2/`}>Próxima &rarr;</a>
          </nav>
        )}
      </div>
      <aside>
        <AdSlot slotKey="sidebar_300x600" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page-head { padding: 44px 0 30px; border-bottom: 1px solid var(--clay-line); margin-bottom: 36px; }
  .page-head h1 { font-family: var(--font-display); font-size: 30px; font-weight: 500; margin: 10px 0 6px; }
  .page-head .count { font-family: var(--font-ui); font-size: 13px; color: #8A8367; margin: 0; }

  .layout { display: grid; grid-template-columns: 1fr 300px; gap: 48px; align-items: start; padding-bottom: 60px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }

  .pagination {
    display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 40px;
    font-family: var(--font-ui); font-size: 13px; color: var(--ink-soft);
  }
  .pagination a { color: var(--olive-deep); font-weight: 500; }

  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr 1fr; }
  }
</style>
