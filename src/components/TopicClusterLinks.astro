const cluster = clusters.find((candidate) => candidate.items.some((item) => item.slug === currentSlug));
const links = cluster?.items.filter((item) => item.slug !== currentSlug).slice(0, 4) ?? [];
---

{cluster && links.length > 0 && (
  <nav class="topic-cluster" aria-labelledby={`topic-cluster-${cluster.id}`}>
    <div class="cluster-label">{cluster.label}</div>
    <h2 id={`topic-cluster-${cluster.id}`}>{cluster.title}</h2>
    <p>{cluster.description}</p>
    <div class="cluster-links">
      {links.map((item) => (
        <a href={`/${item.slug}/`}>
          <strong>{item.title}</strong>
          <span>{item.description}</span>
        </a>
      ))}
    </div>
  </nav>
)}

<style>
  .topic-cluster {
    margin: 38px 0 0; padding: 24px;
    border: 1px solid var(--clay-line); border-radius: var(--radius);
    background: var(--card-bg);
  }
  .cluster-label {
    font-family: var(--font-ui); font-size: 11px; font-weight: 700;
    letter-spacing: .07em; text-transform: uppercase; color: var(--olive-deep);
    margin-bottom: 8px;
  }
  .topic-cluster h2 {
    font-family: var(--font-display); font-size: 22px; font-weight: 500;
    line-height: 1.25; margin: 0 0 8px;
  }
  .topic-cluster p {
    font-size: 14px; line-height: 1.55; color: var(--ink-soft);
    margin: 0 0 18px;
  }
  .cluster-links {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 12px 18px;
  }
  .cluster-links a {
    display: block; padding-top: 12px;
    border-top: 1px solid var(--clay-line);
    color: var(--ink); text-decoration: none;
  }
  .cluster-links a:hover strong { color: var(--ember-deep); }
  .cluster-links strong {
    display: block; font-family: var(--font-display); font-size: 16px;
    font-weight: 500; line-height: 1.3; margin-bottom: 5px;
  }
  .cluster-links span {
    display: block; font-size: 13px; line-height: 1.45;
    color: var(--ink-soft);
  }

  @media (max-width: 560px) {
    .topic-cluster { padding: 20px; }
    .cluster-links { grid-template-columns: 1fr; }
  }
</style>
