---
import { supabase } from '../lib/supabase';

type LeadMagnetConfig = {
  active?: boolean;
  title?: string;
  description?: string;
  buttonLabel?: string;
  privacyNote?: string;
  source?: string;
  downloadUrl?: string;
};

const { postSlug } = Astro.props as { postSlug: string };

let config: LeadMagnetConfig | null = null;

try {
  const { data, error } = await supabase
    .from('public_site_settings')
    .select('value')
    .eq('key', 'lead_magnet_config')
    .maybeSingle();

  if (!error && data?.value) {
    const parsed = JSON.parse(data.value);
    if (parsed?.active && parsed?.title && parsed?.buttonLabel) {
      config = parsed;
    }
  }
} catch {
  config = null;
}
---

{config && (
  <aside class="lead-magnet" aria-label="Material gratuito">
    <div class="lead-copy">
      <span>Material gratuito</span>
      <h2>{config.title}</h2>
      {config.description && <p>{config.description}</p>}
    </div>
    <form class="lead-form" data-post-slug={postSlug} data-offer-title={config.title} data-source={config.source || 'article_lead_magnet'} data-download-url={config.downloadUrl || ''}>
      <div class="lead-fields">
        <input type="text" name="name" placeholder="Seu nome" autocomplete="name" />
        <input type="email" name="email" placeholder="Seu e-mail" autocomplete="email" required />
        <button type="submit">{config.buttonLabel}</button>
        <small>{config.privacyNote || 'Você receberá conteúdos do Monte das Oliveiras. Pode sair da lista quando quiser.'}</small>
      </div>
      <p class="lead-feedback" hidden></p>
    </form>
  </aside>
)}

<script>
  import { createSupabaseBrowserClient } from '../lib/supabase-browser';

  const supabase = createSupabaseBrowserClient();
  const trackLeadEvent = (eventName: string, params: Record<string, string>) => {
    const gtag = (window as any).gtag;
    if (typeof gtag === 'function') gtag('event', eventName, params);
  };

  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    const eventParams = {
      post_slug: form.dataset.postSlug || '',
      offer_title: form.dataset.offerTitle || '',
    };
    let started = false;
    trackLeadEvent('lead_magnet_view', eventParams);

    form.querySelectorAll('input').forEach((input) => {
      input.addEventListener('focus', () => {
        if (started) return;
        started = true;
        trackLeadEvent('lead_form_start', eventParams);
      }, { once: true });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const button = form.querySelector('button') as HTMLButtonElement;
      const feedback = form.querySelector('.lead-feedback') as HTMLParagraphElement;
      const originalButtonLabel = button.textContent || 'Receber material';
      const formData = new FormData(form);
      const name = String(formData.get('name') || '').trim();
      const email = String(formData.get('email') || '').trim();
      trackLeadEvent('lead_form_submit', eventParams);

      button.disabled = true;
      button.textContent = 'Enviando...';
      feedback.hidden = true;

      const { error } = await supabase.functions.invoke('subscribe-lead', {
        body: {
          name,
          email,
          source: form.dataset.source || 'article_lead_magnet',
          postSlug: form.dataset.postSlug || null,
          offerTitle: form.dataset.offerTitle || null,
          consent: true,
        },
      });

      if (error) {
        feedback.textContent = 'Ainda estamos concluindo a configuração da lista de e-mails. Tente novamente mais tarde.';
        feedback.className = 'lead-feedback error';
        feedback.hidden = false;
        button.disabled = false;
        button.textContent = originalButtonLabel;
        return;
      }

      const downloadUrl = form.dataset.downloadUrl;
      if (downloadUrl) {
        trackLeadEvent('lead_download_click', { ...eventParams, download_url: downloadUrl });
        window.location.assign(downloadUrl);
        return;
      }

      trackLeadEvent('lead_capture_success', eventParams);
      feedback.textContent = 'Cadastro recebido! O material será liberado assim que o link de download for configurado.';
      feedback.className = 'lead-feedback ok';
      feedback.hidden = false;
      button.disabled = false;
      button.textContent = originalButtonLabel;
    });
  });
</script>

<style>
  .lead-magnet {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 22px;
    margin: 34px 0;
    padding: 22px;
    border: 1px solid #E4E0D3;
    border-radius: 8px;
    background: #F7F3E8;
  }

  .lead-copy span {
    display: block;
    margin-bottom: 7px;
    color: var(--ember);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .lead-copy h2 {
    margin: 0 0 8px;
    color: var(--olive-deep);
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 600;
    line-height: 1.2;
  }

  .lead-copy p {
    margin: 0;
    color: #4A4842;
    font-size: 15px;
    line-height: 1.55;
  }

  .lead-form,
  .lead-fields {
    display: grid;
    gap: 9px;
  }

  .lead-form input {
    width: 100%;
    box-sizing: border-box;
    min-height: 40px;
    padding: 8px 11px;
    border: 1px solid #E4E0D3;
    border-radius: 6px;
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 13px;
  }

  .lead-form button {
    min-height: 42px;
    border: 0;
    border-radius: 7px;
    background: var(--olive-deep);
    color: #fff;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 800;
  }

  .lead-form button:disabled {
    opacity: .75;
    cursor: wait;
  }

  .lead-form small {
    color: #8A8367;
    font-family: var(--font-ui);
    font-size: 11.5px;
    line-height: 1.4;
  }

  .lead-feedback {
    margin: 0;
    padding: 12px 14px;
    border-radius: 8px;
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: 1.45;
  }

  .lead-feedback.ok {
    border: 1px solid #D6DEC0;
    background: #EEF1E4;
    color: var(--olive-deep);
  }

  .lead-feedback.error {
    border: 1px solid #EBC6B7;
    background: #FFF5EF;
    color: #A6462A;
  }

  @media (max-width: 680px) {
    .lead-magnet {
      grid-template-columns: 1fr;
      padding: 18px;
    }
  }
</style>
