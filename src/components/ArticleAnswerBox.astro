---
interface Props {
  slug: string;
}

import { priorityArticleAnswers } from '../data/priorityArticleAnswers';

const { slug } = Astro.props;
const box = priorityArticleAnswers[slug];
---

{box && (
  <aside class="answer-box" aria-label="Resposta rápida do estudo">
    <div class="answer-label">Resposta rápida</div>
    <h2>{box.question}</h2>
    <p>{box.answer}</p>
    <ul>
      {box.bullets.map((item) => <li>{item}</li>)}
    </ul>
    {box.links && (
      <div class="answer-links">
        {box.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    )}
  </aside>
)}

<style>
  .answer-box {
    margin: 0 0 30px; padding: 22px 24px;
    border: 1px solid var(--clay-line); border-left: 4px solid var(--olive);
    background: var(--card-bg); border-radius: var(--radius);
  }
  .answer-label {
    font-family: var(--font-ui); font-size: 11px; font-weight: 700;
    letter-spacing: .07em; text-transform: uppercase; color: var(--olive-deep);
    margin-bottom: 8px;
  }
  .answer-box h2 {
    font-family: var(--font-display); font-weight: 500; font-size: 23px;
    line-height: 1.25; margin: 0 0 10px;
  }
  .answer-box p { font-size: 15px; line-height: 1.6; color: var(--ink); margin: 0 0 14px; }
  .answer-box ul { margin: 0; padding-left: 19px; color: var(--ink-soft); }
  .answer-box li { font-size: 14px; line-height: 1.5; margin-bottom: 7px; }
  .answer-box li:last-child { margin-bottom: 0; }
  .answer-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .answer-links a {
    font-family: var(--font-ui); font-size: 12px; font-weight: 600;
    color: var(--olive-deep); text-decoration: none;
    border-bottom: 1px solid rgba(90, 101, 54, .35);
  }
  .answer-links a:hover { color: var(--ember-deep); border-color: currentColor; }

  @media (max-width: 560px) {
    .answer-box { padding: 18px 18px; }
    .answer-box h2 { font-size: 20px; }
  }
</style>
