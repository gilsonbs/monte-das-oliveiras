---
interface Props {
  currentSlug?: string;
  compact?: boolean;
}

const { currentSlug, compact = false } = Astro.props;

const studies = [
  {
    slug: 'o-absinto-do-apocalipse',
    title: 'Absinto no Apocalipse',
    description: 'Entenda a terceira trombeta e o significado profético de Absinto.',
    group: 'Escatologia',
  },
  {
    slug: 'profecias-biblicas',
    title: 'Profecias bíblicas cumpridas',
    description: 'Veja exemplos e significados das profecias nas Escrituras.',
    group: 'Profecias',
  },
  {
    slug: 'parabola-dos-talentos',
    title: 'Parábola dos talentos',
    description: 'Uma explicação bíblica sobre fidelidade, serviço e responsabilidade.',
    group: 'Ensinos de Jesus',
  },
  {
    slug: 'pos-e-pre-tribulacionismo',
    title: 'Pré e pós-tribulacionismo',
    description: 'Compare as principais visões cristãs sobre arrebatamento e tribulação.',
    group: 'Escatologia',
  },
  {
    slug: 'tocar-nas-partes-intimas-e-pecado',
    title: 'Tocar nas partes íntimas é pecado?',
    description: 'Princípios bíblicos sobre pureza, consciência e domínio próprio.',
    group: 'Vida cristã',
  },
].filter((study) => study.slug !== currentSlug);
---

<section class:list={['priority-studies', { compact }]}>
  <div class="priority-head">
    <div>
      <div class="eyebrow">Estudos essenciais</div>
      <h2>{compact ? 'Também vale ler' : 'Temas bíblicos em destaque'}</h2>
    </div>
  </div>

  <div class="priority-grid">
    {studies.map((study) => (
      <a class="priority-item" href={`/${study.slug}/`}>
        <span>{study.group}</span>
        <h3>{study.title}</h3>
        {!compact && <p>{study.description}</p>}
      </a>
    ))}
  </div>
</section>

<style>
  .priority-studies { padding: 2px 0 54px; }
  .priority-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; }
  .priority-head .eyebrow {
    font-family: var(--font-ui); font-size: 11px; font-weight: 600; letter-spacing: .07em;
    text-transform: uppercase; color: var(--olive-deep);
  }
  .priority-head h2 { font-family: var(--font-display); font-weight: 500; font-size: 22px; margin: 4px 0 0; }
  .priority-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .priority-item {
    border-top: 2px solid var(--olive); padding: 14px 0 0;
    min-width: 0;
  }
  .priority-item span {
    display: block; font-family: var(--font-ui); font-size: 10px; font-weight: 600;
    letter-spacing: .06em; text-transform: uppercase; color: #8A8367; margin-bottom: 8px;
  }
  .priority-item h3 {
    font-family: var(--font-display); font-weight: 500; font-size: 17px;
    line-height: 1.25; margin: 0 0 8px;
  }
  .priority-item p { font-size: 13px; line-height: 1.45; color: var(--ink-soft); margin: 0; }

  .priority-studies.compact { padding: 0; }
  .priority-studies.compact .priority-head { margin-bottom: 8px; }
  .priority-studies.compact .priority-head h2 {
    font-family: var(--font-display); font-size: 16px; font-weight: 500;
    margin: 0; padding-bottom: 10px; border-bottom: 1px solid var(--clay-line);
  }
  .priority-studies.compact .priority-head .eyebrow { display: none; }
  .priority-studies.compact .priority-grid { display: flex; flex-direction: column; gap: 0; }
  .priority-studies.compact .priority-item {
    border-top: 0; border-bottom: 1px solid var(--clay-line); padding: 11px 0;
  }
  .priority-studies.compact .priority-item h3 { font-size: 13px; line-height: 1.35; margin-bottom: 0; }
  .priority-studies.compact .priority-item span { margin-bottom: 5px; }

  @media (max-width: 980px) {
    .priority-grid { grid-template-columns: repeat(2, 1fr); gap: 22px; }
  }

  @media (max-width: 560px) {
    .priority-grid { grid-template-columns: 1fr; }
    .priority-studies { padding-bottom: 42px; }
  }
</style>
